# =============================================================================
# Restic Environment Template
# Copy to restic.env and fill in values for standalone CLI usage.
# Inside the Docker stack, these are set via the root .env file.
# =============================================================================

# Local MinIO backend
RESTIC_REPOSITORY=s3:http://localhost:9010/restic-backups
RESTIC_PASSWORD=changeme-restic-password
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme-minio-password

# --- OR --- Remote S3 backends (uncomment one):

# AWS S3
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-bucket-name
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Backblaze B2
# RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/your-bucket-name
# AWS_ACCESS_KEY_ID=your-b2-key-id
# AWS_SECRET_ACCESS_KEY=your-b2-app-key

# Wasabi
# RESTIC_REPOSITORY=s3:s3.wasabisys.com/your-bucket-name
# AWS_ACCESS_KEY_ID=your-wasabi-key
# AWS_SECRET_ACCESS_KEY=your-wasabi-secret

# --- OR --- Restic REST server
# RESTIC_REPOSITORY=rest:http://restic-rest:8000/

# Retention policy
RESTIC_KEEP_HOURLY=24
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
RESTIC_KEEP_YEARLY=3
