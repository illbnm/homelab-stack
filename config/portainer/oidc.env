# Portainer OIDC SSO Configuration for Authentik
# Set via Portainer UI: Settings → Authentication → OAuth
# Provider: Custom
OAUTH_PROVIDER=Authentik
CLIENT_ID=${PORTAINER_OAUTH_CLIENT_ID}
CLIENT_SECRET=${PORTAINER_OAUTH_CLIENT_SECRET}
AUTHORIZATION_ENDPOINT=https://auth.${DOMAIN}/application/o/authorize/
TOKEN_ENDPOINT=https://auth.${DOMAIN}/application/o/token/
USER_INFO_ENDPOINT=https://auth.${DOMAIN}/application/o/userinfo/
LOGOUT_ENDPOINT=https://auth.${DOMAIN}/application/o/portainer/end-session/
SCOPES=openid profile email
USER_IDENTIFIER=preferred_username
