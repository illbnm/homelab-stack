# =============================================================================
# HomeLab Stack — OIDC Integration Variables
# Generated by scripts/authentik-setup.sh — do not edit manually.
# =============================================================================

# Grafana OIDC (Generic OAuth)
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=

# Gitea OIDC
GITEA_OAUTH2_CLIENT_ID=
GITEA_OAUTH2_CLIENT_SECRET=
GITEA_OAUTH2_OPENID_CONNECT_URL=https://${AUTHENTIK_DOMAIN}/application/o/gitea/

# Nextcloud OIDC (Social Login app)
NEXTCLOUD_OIDC_CLIENT_ID=
NEXTCLOUD_OIDC_CLIENT_SECRET=
NEXTCLOUD_OIDC_PROVIDER=authentik

# Outline OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Open WebUI OIDC
OPEN_WEBUI_OIDC_CLIENT_ID=
OPEN_WEBUI_OIDC_CLIENT_SECRET=

# Portainer OAuth
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=
