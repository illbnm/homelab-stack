# Observability Stack Environment Variables
# Copy to .env and fill in your values

# ── Domain ──────────────────────────────────────────────────────
DOMAIN=example.com

# ── Data Retention ───────────────────────────────────────────────
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=7d
TEMPO_RETENTION=3d

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Authentik OIDC
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=

# ── Grafana OnCall ───────────────────────────────────────────────
ONCALL_SECRET_KEY=changeme

# ── Timezone ───────────────────────────────────────────────────
TZ=Etc/UTC