# Observability Stack Environment Variables

# Base Domain
DOMAIN=example.com

# Grafana Config
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE

# OIDC Authentik Integration
OIDC_CLIENT_ID=grafana
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_SECRET

# Data Retention Policies
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=7d
TEMPO_RETENTION=3d
