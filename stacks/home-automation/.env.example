# 复制为 .env 后按需修改
TZ=Asia/Shanghai

# 端口（Home Assistant 使用 host 网络，HA_PORT 仅在 bridge 模式下生效）
HA_PORT=8123
MQTT_PORT=1883
NODERED_PORT=1880
ZIGBEE2MQTT_PORT=8080
ESPHOME_PORT=6052

# Zigbee 协调器设备（宿主机路径）
ZIGBEE_DEVICE=/dev/ttyUSB0

# MQTT 账号，需与 scripts/setup-mosquitto.sh 生成的一致
MQTT_USER=mqtt
MQTT_PASSWORD=changeme
