# Home Automation Stack - Environment Variables
# Copy this file to .env in the same directory and adjust as needed

# Timezone (default: Asia/Shanghai)
TZ=Asia/Shanghai

# Domain for Traefik routing (used in labels)
DOMAIN=your-domain.com

# Optional: Zigbee2MQTT serial port (if using USB coordinator)
# ZIGBEE2MQTT_SERIAL_PORT=/dev/ttyACM0

# Optional: Home Assistant configuration (leave empty for defaults)
# HA_CONFIG_PATH=./config
