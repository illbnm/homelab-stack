# Home Automation Stack Environment Configuration
# ==============================================

# Timezone and User Configuration
TIMEZONE=UTC
PUID=1000
PGID=1000

# Home Assistant Configuration
HOMEASSISTANT_TIMEZONE=${TIMEZONE}
HOMEASSISTANT_LATITUDE=0.0
HOMEASSISTANT_LONGITUDE=0.0
HOMEASSISTANT_ELEVATION=0
HOMEASSISTANT_UNIT_SYSTEM=metric

# MQTT Configuration
MQTT_USER=homeassistant
MQTT_PASSWORD=changeme_CHANGE_IN_PRODUCTION
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=home

# Zigbee2MQTT Configuration
ZIGBEE2MQTT_ADAPTER=znp
ZIGBEE2MQTT_PORT=/dev/ttyUSB0
ZIGBEE2MQTT_BAUDRATE=115200
ZIGBEE2MQTT_RTSCTS=false
ZIGBEE2MQTT_FRONTEND_PORT=8080
ZIGBEE2MQTT_FRONTEND_HOST=0.0.0.0

# Database Configuration (Optional)
ENABLE_MARIADB=false
MARIADB_ROOT_PASSWORD=rootpassword_CHANGE
MARIADB_DATABASE=homeassistant
MARIADB_USER=homeassistant
MARIADB_PASSWORD=dbpassword_CHANGE

ENABLE_INFLUXDB=false
INFLUXDB_DB=homeassistant
INFLUXDB_USER=homeassistant
INFLUXDB_USER_PASSWORD=influxpassword_CHANGE
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=adminpassword_CHANGE

# Monitoring Configuration
ENABLE_GRAFANA=false
GRAFANA_ADMIN_PASSWORD=admin_CHANGE
GRAFANA_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

ENABLE_PROMETHEUS=false
PROMETHEUS_RETENTION_DAYS=30

# Network Configuration
HOME_AUTOMATION_SUBNET=172.22.0.0/24
HOME_AUTOMATION_GATEWAY=172.22.0.1

# Security Configuration
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs
SSL_CERT_DOMAIN=home.local
ENABLE_AUTHENTICATION=true

# Performance Configuration
HOMEASSISTANT_CPU_LIMIT=2.0
HOMEASSISTANT_MEMORY_LIMIT=2G
ZIGBEE2MQTT_CPU_LIMIT=0.5
ZIGBEE2MQTT_MEMORY_LIMIT=512M
MOSQUITTO_CPU_LIMIT=0.3
MOSQUITTO_MEMORY_LIMIT=256M
NODERED_CPU_LIMIT=0.5
NODERED_MEMORY_LIMIT=512M

# Feature Flags
ENABLE_ESPHOME=true
ENABLE_APPDAEMON=true
ENABLE_ZIGBEE_VISUALIZER=true
ENABLE_MONITORING_STACK=false

# Backup Configuration
BACKUP_SCHEDULE="0 4 * * *"  # Daily at 4 AM
BACKUP_RETENTION_DAYS=30
ENCRYPT_BACKUPS=true
BACKUP_INCLUDE_CONFIG=true
BACKUP_INCLUDE_DATABASE=true

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_ROTATION_SIZE=100M
ENABLE_DEBUG_LOGS=false

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Automation Configuration
DEFAULT_AUTOMATIONS_ENABLED=true
SCENE_TEMPLATES_ENABLED=true
NOTIFICATION_INTEGRATIONS_ENABLED=true

# Integration Configuration
WEATHER_INTEGRATION=openweathermap
CALENDAR_INTEGRATION=google_calendar
MEDIA_INTEGRATION=spotify
VOICE_ASSISTANT=none

# Device Limits
MAX_ZIGBEE_DEVICES=100
MAX_MQTT_DEVICES=500
MAX_AUTOMATIONS=1000

# Notes:
# 1. Change all passwords and API keys in production
# 2. Set correct latitude/longitude for your location
# 3. Configure proper SSL certificates for HTTPS
# 4. Adjust resource limits based on your hardware
# 5. Enable/disable optional services as needed
# 6. Set up proper device permissions for USB adapters