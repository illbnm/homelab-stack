# ==============================================================================
# Home Automation Stack Environment Variables
# ==============================================================================

# Timezone
TZ=UTC

# Data directories (relative to project root or absolute paths)
DATA_DIR=./data
CONFIG_DIR=./config

# Zigbee coordinator device path (e.g., /dev/ttyACM0, /dev/ttyUSB0)
ZIGBEE_DEVICE=/dev/ttyACM0