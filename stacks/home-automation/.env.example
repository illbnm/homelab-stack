# Home Automation Stack Environment Variables

# Data directory for all services
DATA_DIR=./data

# Domain for Traefik routing
DOMAIN: example.com

# Zigbee adapter device path (e.g., /dev/ttyUSB0, /dev/ttyACM0, /dev/serial/by-id/...)
# ZIGbee2MQTT will use this device to communicate with Zigbee coordinator
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0