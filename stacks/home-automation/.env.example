# Home Automation Stack Environment Variables

# Timezone (e.g., America/New_York, Europe/London, Asia/Shanghai)
TZ=UTC

# Data directory for persistent storage
DATA_DIR=./data

# Config directory for service configurations
CONFIG_DIR=./config

# Zigbee adapter device path (e.g., /dev/ttyUSB0, /dev/ttyACM0)
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0