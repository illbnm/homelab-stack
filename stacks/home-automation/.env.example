# Home Automation Stack Configuration

DOMAIN=example.com
TZ=Asia/Shanghai

# Mosquitto MQTT Broker
# Generate password file after first start:
#   docker exec mosquitto mosquitto_passwd -c -b /mosquitto/config/passwd mqtt_user <password>
#   docker restart mosquitto
MQTT_USER=mqtt_user
MQTT_PASS=changeme-mqtt-pass

# Zigbee2MQTT
ZIGBEE2MQTT_MQTT_USER=mqtt_user
ZIGBEE2MQTT_MQTT_PASS=changeme-mqtt-pass

# ESPHome (optional OTA password)
ESPHOME_OTA_PASSWORD=changeme-ota-pass