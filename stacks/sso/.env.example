# SSO Stack Environment Variables
# Copy to .env and fill in your values

# ── Domain ──────────────────────────────────────────────────────
DOMAIN=example.com

# ── Authentik Core ──────────────────────────────────────────────
# Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=changeme-please-generate-a-real-key

# ── PostgreSQL ──────────────────────────────────────────────────
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
# Generate with: openssl rand -hex 24
AUTHENTIK_PG_PASS=changeme-generate-a-secure-password

# ── SMTP (Optional, for password recovery) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
SMTP_FROM=authentik@example.com

# ════════════════════════════════════════════════════════════════
# OIDC Client Credentials (auto-generated by scripts/authentik-setup.sh)
# ════════════════════════════════════════════════════════════════

# Grafana
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

# Gitea
GITEA_OIDC_CLIENT_ID=
GITEA_OIDC_CLIENT_SECRET=

# Nextcloud
NEXTCLOUD_OIDC_CLIENT_ID=
NEXTCLOUD_OIDC_CLIENT_SECRET=

# Outline
OUTLINE_OIDC_CLIENT_ID=
OUTLINE_OIDC_CLIENT_SECRET=

# Open WebUI
OPENWEBUI_OIDC_CLIENT_ID=
OPENWEBUI_OIDC_CLIENT_SECRET=

# Portainer
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=