# =============================================================================
# SSO Stack (Authentik) — Environment Variables
# Copy to .env and fill ALL values before running docker compose up -d.
# =============================================================================

AUTHENTIK_SECRET_KEY=change-me-64-hex-chars          # openssl rand -hex 32
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-strong        # first-boot admin password
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-api-token        # used by scripts/authentik-setup.sh
AUTHENTIK_DB_PASSWORD=change-me-db-password
AUTHENTIK_DOMAIN=auth.example.com
BASE_DOMAIN=example.com
