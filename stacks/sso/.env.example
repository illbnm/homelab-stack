# ==============================================================================
# Homelab Stack — SSO (Authentik) Environment Variables
# Copy to .env and replace all placeholder values before starting
# ==============================================================================

DOMAIN=homelab.example.com
TZ=Asia/Shanghai

# PostgreSQL Database Credentials
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=ChangeMe_PostgresStrongPassword_2026!

# Authentik Core Secrets (Generate with: openssl rand -base64 48)
AUTHENTIK_SECRET_KEY=ChangeMe_AuthentikSecretKey_AtLeast50CharsLong_2026!
AUTHENTIK_BOOTSTRAP_PASSWORD=ChangeMe_AdminBootstrapPassword_2026!
AUTHENTIK_BOOTSTRAP_TOKEN=ChangeMe_BootstrapApiToken_2026!
AUTHENTIK_BOOTSTRAP_EMAIL=admin@homelab.example.com

# OIDC Client Secrets for Downstream Services
GRAFANA_OIDC_CLIENT_SECRET=ChangeMe_GrafanaOidcSecret
GITEA_OIDC_CLIENT_SECRET=ChangeMe_GiteaOidcSecret
NEXTCLOUD_OIDC_CLIENT_SECRET=ChangeMe_NextcloudOidcSecret
OUTLINE_OIDC_CLIENT_SECRET=ChangeMe_OutlineOidcSecret
OPENWEBUI_OIDC_CLIENT_SECRET=ChangeMe_OpenWebUIOidcSecret
PORTAINER_OIDC_CLIENT_SECRET=ChangeMe_PortainerOidcSecret
