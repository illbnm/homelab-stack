# SSO Stack Environment Variables

# Base Domain
DOMAIN=example.com

# Authentik Database Password
AUTHENTIK_DB_PASSWORD=CHANGE_ME_SECURE_AUTH_DB

# Authentik Secrets
# Generate with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=CHANGE_ME_SECRET_KEY

# Authentik Default Admin User
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASS
