# Authentik SSO Stack Environment Variables
# Copy this file to .env and fill required values
# See README.md for details

# Required: Random secret key (use: openssl rand -base64 32)
AUTHENTIK_SECRET_KEY=

# Required: PostgreSQL credentials
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=

# Required: Redis password
AUTHENTIK_REDIS_PASSWORD=

# Required: Initial admin credentials
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Required: Bootstrap API token (use: openssl rand -hex 32)
AUTHENTIK_BOOTSTRAP_TOKEN=

# Required: Domain for Authentik (e.g., auth.yourdomain.com)
AUTHENTIK_DOMAIN=

# Optional: Global environment variables used by other stacks
# These are shared via root .env
AUTHENTIK_DOMAIN=

# Optional: Log level (debug, info, warning, error)
AUTHENTIK_LOG_LEVEL=info
