# =============================================================================
# HomeLab Stack — Backup & DR Environment
# =============================================================================
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
PUID=1000
PGID=1000

# Backup source directory (what to back up)
BACKUP_SOURCE=/opt/homelab

# Local backup storage
BACKUP_LOCAL_DIR=/opt/homelab-backups

# Retention (days)
BACKUP_RETENTION_DAYS=7

# Duplicati web UI password
DUPLICATI_PASSWORD=CHANGE_ME_DUPLICATI_PASSWORD

# Restic repository password (for encryption)
RESTIC_PASSWORD=CHANGE_ME_RESTIC_PASSWORD

# Backup target: local | s3 | b2 | sftp
BACKUP_TARGET=local

# S3 / MinIO target (if BACKUP_TARGET=s3)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Backblaze B2 target (if BACKUP_TARGET=b2)
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
B2_BUCKET=

# SFTP target (if BACKUP_TARGET=sftp)
SFTP_HOST=
SFTP_USER=
SFTP_PATH=

# Notification (ntfy) — optional
NTFY_URL=
