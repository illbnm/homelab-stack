# HomeLab Backup & DR Stack Environment Template
DOMAIN=lab.example.com
PUID=1000
PGID=1000
TZ=Asia/Shanghai
BACKUP_ROOT=/data/backups
SOURCE_DATA_ROOT=/data
BACKUP_TARGET=local
# Supported BACKUP_TARGET values: local | s3 | b2 | sftp | r2
RESTIC_REPOSITORY=/data/backups/restic-repo
RESTIC_PASSWORD=change_me_restic_encryption_password
DUPLICATI_PASS=change_me_duplicati_webui_password
NTFY_URL=https://ntfy.lab.example.com
NTFY_TOPIC=homelab-backups
AWS_ACCESS_KEY_ID=change_me_s3_or_r2_key
AWS_SECRET_ACCESS_KEY=change_me_s3_or_r2_secret
B2_ACCOUNT_ID=change_me_b2_account_id
B2_ACCOUNT_KEY=change_me_b2_account_key
