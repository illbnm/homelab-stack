# =============================================================================
# Backup & DR Stack — Environment Variables
# =============================================================================

# Timezone
TZ=Asia/Shanghai

# User/Group IDs for container processes
PUID=1000
PGID=1000

# Domain (used for Traefik routing)
DOMAIN=example.com

# =============================================================================
# Duplicati Configuration
# =============================================================================

# Backup source path (mounted as /source in container)
STORAGE_PATH=/data

# Duplicati encryption passphrase (for backup encryption)
DUPLICATI_PASSPHRASE=your-secure-passphrase-here

# Duplicati backup retention policy (number of versions to keep)
DUPLICATI_RETENTION=7

# Duplicati backup schedule (cron expression)
DUPLICATI_BACKUP_CRON=0 2 * * *

# =============================================================================
# Restic Configuration
# =============================================================================

# Disable authentication for Restic REST server (not recommended for production)
RESTIC_DISABLE_AUTH=false

# Restic repository password
RESTIC_PASSWORD=your-secure-restic-password-here

# Restic backup retention policy (daily/weekly/monthly)
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=3

# Restic backup schedule (cron expression)
RESTIC_BACKUP_CRON=0 3 * * *

# =============================================================================
# Backup Targets (Duplicati)
# =============================================================================

# Local backup path
BACKUP_LOCAL_PATH=/backups/duplicati

# S3-compatible endpoint (MinIO, AWS S3, etc.)
BACKUP_S3_ENDPOINT=your-s3-endpoint
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key
BACKUP_S3_BUCKET_NAME=your-backup-bucket

# Backblaze B2
BACKUP_B2_ACCOUNT_ID=your-b2-account-id
BACKUP_B2_APPLICATION_KEY=your-b2-application-key
BACKUP_B2_BUCKET_NAME=your-b2-bucket-name

# SFTP
BACKUP_SFTP_HOST=your-sftp-host
BACKUP_SFTP_USERNAME=your-sftp-username
BACKUP_SFTP_PASSWORD=your-sftp-password
BACKUP_SFTP_PATH=/path/to/backups

# Cloudflare R2
BACKUP_R2_ACCOUNT_ID=your-r2-account-id
BACKUP_R2_ACCESS_KEY_ID=your-r2-access-key-id
BACKUP_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
BACKUP_R2_BUCKET_NAME=your-r2-bucket-name

# =============================================================================
# Notifications
# =============================================================================

# ntfy notification topic (for backup completion/failure alerts)
NTFY_TOPIC=homelab-backups

# ntfy server URL (if using external ntfy server)
NTFY_SERVER=https://ntfy.example.com

# =============================================================================
# Disaster Recovery
# =============================================================================

# Recovery target path (where to restore backups)
RECOVERY_TARGET_PATH=/recovery

# Backup verification schedule (cron expression)
BACKUP_VERIFY_CRON=0 4 * * 0

# Backup cleanup schedule (cron expression)
BACKUP_CLEANUP_CRON=0 5 * * 0
