# ---- Backup Target ----
# local | s3 | b2 | sftp | r2
BACKUP_TARGET=local

# ---- Local Backup Path ----
BACKUP_LOCAL_PATH=/opt/homelab/backups

# ---- S3 (MinIO / any S3-compatible) ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=homelab-backup
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---- Backblaze B2 ----
BACKUP_B2_ACCOUNT_ID=
BACKUP_B2_ACCOUNT_KEY=
BACKUP_B2_BUCKET=

# ---- SFTP ----
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PATH=/backup/homelab

# ---- Cloudflare R2 ----
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
BACKUP_R2_BUCKET=

# ---- Restic (local repo) ----
RESTIC_PASSWORD=
RESTIC_REPO=/data

# ---- Duplicati ----
DUPLICATI_PASSWORD=

# ---- ntfy Notification ----
NTFY_URL=
NTFY_TOPIC=homelab-backup

# ---- Encryption ----
BACKUP_ENCRYPTION_KEY=

# ---- Schedule ----
BACKUP_CRON=0 2 * * *
TZ=Asia/Shanghai
DOMAIN=example.com
