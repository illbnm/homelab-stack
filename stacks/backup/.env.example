TZ=Asia/Shanghai
DOMAIN=localhost

# Path to data you want to back up
DATA_PATH=/data/storage

# Path where backups are stored (external drive / NAS mount)
BACKUP_PATH=/mnt/backups

# Duplicati encryption key (generate: openssl rand -base64 32)
DUPLICATI_ENCRYPTION_KEY=

# Restic repository password
RESTIC_PASSWORD=
