# Backup Stack Environment Variables
# Copy to .env and fill in your values

# ── Domain ──────────────────────────────────────────────────────
DOMAIN=example.com

# ── Backup Target ───────────────────────────────────────────────
# Options: local | s3 | b2 | sftp | r2
BACKUP_TARGET=local

# ── Local Backup ────────────────────────────────────────────────
LOCAL_BACKUP_DIR=/data/backups

# ── S3 (MinIO or AWS) ────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=homelab-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── Backblaze B2 ────────────────────────────────────────────────
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
B2_BUCKET=homelab-backups

# ── Cloudflare R2 ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=homelab-backups

# ── SFTP ────────────────────────────────────────────────────────
SFTP_HOST=
SFTP_USER=
SFTP_PORT=22
SFTP_PATH=/backups
SFTP_KEY_FILE=

# ── Restic REST Server ──────────────────────────────────────────
RESTIC_REPOSITORY=rest:http://restic-server:8000/
RESTIC_PASSWORD=changeme-generate-secure-password
RESTIC_AUTH_ENABLED=true

# ── Duplicati ───────────────────────────────────────────────────
DATA_ROOT=/data
TZ=UTC

# ── Encryption ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=changeme-generate-encryption-key

# ── Notifications (ntfy) ────────────────────────────────────────
NTFY_URL=https://ntfy.sh/homelab-backups
NTFY_TOPIC=homelab-backups

# ── Retention Policy ────────────────────────────────────────────
# Keep N copies per period
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
KEEP_YEARLY=1

# ── Stack Data Paths ────────────────────────────────────────────
# Map stack names to their volume/data paths
STACK_BASE=/data/base
STACK_MEDIA=/data/media
STACK_STORAGE=/data/storage
STACK_MONITORING=/data/monitoring
STACK_NETWORK=/data/network
STACK_PRODUCTIVITY=/data/productivity
STACK_AI=/data/ai
STACK_SSO=/data/sso
STACK_DATABASES=/data/databases
STACK_NOTIFICATIONS=/data/notifications