# Notifications Stack - Environment Variables
# Copy this file to .env in the stack directory or link from root .env

# Required: Your root domain (e.g., home.example.com)
DOMAIN=home.example.com

# ntfy settings
# Set NTFY_USER and NTFY_PASSWORD to enable HTTP basic auth for ntfy
NTFY_USER=
NTFY_PASSWORD=

# Gotify settings
# Default admin credentials (used on first start)
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASSWORD=changeme

# Timezone
TZ=Asia/Shanghai
