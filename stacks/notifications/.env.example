# Notifications Stack Environment Configuration
# ============================================

# General Configuration
TIMEZONE=UTC
NOTIFICATIONS_NETWORK_SUBNET=172.23.0.0/24
NOTIFICATIONS_NETWORK_GATEWAY=172.23.0.1

# Notification Server (Gotify) Configuration
NOTIFICATION_ADMIN_USER=admin
NOTIFICATION_ADMIN_PASSWORD=changeme_CHANGE_IN_PRODUCTION
NOTIFICATION_PASSWORD_STRENGTH=10
NOTIFICATION_SERVER_URL=http://localhost:8080

# NTFY Configuration
NTFY_BASE_URL=http://localhost:8081
NTFY_AUTH_DEFAULT_ACCESS=read-write
NTFY_AUTH_FILE=/etc/ntfy/user.db
NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
NTFY_CACHE_DURATION=12h

# Apprise Configuration
APPRISE_DEBUG=false
APPRISE_LOG_LEVEL=warning
APPRISE_CONFIG_PATH=/config/apprise.yml
APPRISE_STATELESS=true

# Grafana Configuration (Optional)
GRAFANA_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin_CHANGE
GRAFANA_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# Prometheus Configuration (Optional)
PROMETHEUS_ENABLED=false
PROMETHEUS_RETENTION_DAYS=7
PROMETHEUS_SCRAPE_INTERVAL=15s

# AlertManager Configuration (Optional)
ALERTMANAGER_ENABLED=false
ALERTMANAGER_SMTP_FROM=${ALERTMANAGER_SMTP_FROM:-alerts@example.com}
ALERTMANAGER_SMTP_SMARTHOST=${ALERTMANAGER_SMTP_SMARTHOST:-smtp.example.com:587}
ALERTMANAGER_SMTP_AUTH_USERNAME=${ALERTMANAGER_SMTP_AUTH_USERNAME}
ALERTMANAGER_SMTP_AUTH_PASSWORD=${ALERTMANAGER_SMTP_AUTH_PASSWORD}

# Redis Configuration (Optional)
REDIS_ENABLED=false
REDIS_PASSWORD=redispassword_CHANGE
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# PostgreSQL Configuration (Optional)
POSTGRES_ENABLED=false
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=postgrespassword_CHANGE
POSTGRES_MAX_CONNECTIONS=100

# SMTP Relay Configuration (Optional)
SMTP_RELAY_ENABLED=false
SMTP_RELAY_HOST=smtp.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=your-email@gmail.com
SMTP_RELAY_PASSWORD=your-app-password

# Webhook Configuration
WEBHOOK_SECRET=webhooksecret_CHANGE
WEBHOOK_MAX_BODY_SIZE=10M
WEBHOOK_RATE_LIMIT=100/hour

# Security Configuration
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs
SSL_CERT_DOMAIN=notifications.local
ENABLE_AUTHENTICATION=true
API_KEY_GENERATION=true

# Channel Configuration
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
DISCORD_WEBHOOK_URL=${DISCORD_WEBHOOK_URL}
PUSHOVER_USER_KEY=${PUSHOVER_USER_KEY}
PUSHOVER_API_TOKEN=${PUSHOVER_API_TOKEN}
MATRIX_HOMESERVER=${MATRIX_HOMESERVER}
MATRIX_USER_ID=${MATRIX_USER_ID}
MATRIX_ACCESS_TOKEN=${MATRIX_ACCESS_TOKEN}
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Performance Configuration
NOTIFICATION_SERVER_CPU_LIMIT=1.0
NOTIFICATION_SERVER_MEMORY_LIMIT=512M
NTFY_CPU_LIMIT=0.5
NTFY_MEMORY_LIMIT=256M
APPRISE_CPU_LIMIT=0.5
APPRISE_MEMORY_LIMIT=256M
QUEUE_WORKERS=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=30

# Feature Flags
ENABLE_GOTIFY=true
ENABLE_NTFY=true
ENABLE_APPRISE=true
ENABLE_WEBHOOK_RECEIVER=true
ENABLE_MONITORING_STACK=false
ENABLE_DATABASE_STORAGE=false
ENABLE_MESSAGE_QUEUE=false
ENABLE_SMTP_RELAY=false

# Backup Configuration
BACKUP_SCHEDULE="0 5 * * *"  # Daily at 5 AM
BACKUP_RETENTION_DAYS=30
ENCRYPT_BACKUPS=true
BACKUP_INCLUDE_CONFIG=true
BACKUP_INCLUDE_DATABASE=true

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_ROTATION_SIZE=100M
ENABLE_ACCESS_LOGS=true
ENABLE_AUDIT_LOGS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=hour
RATE_LIMIT_BURST=10

# Message Processing
MESSAGE_MAX_SIZE=1M
MESSAGE_RETENTION_DAYS=30
MESSAGE_ENCRYPTION=false
MESSAGE_COMPRESSION=true

# Integration Configuration
PROMETHEUS_ALERTMANAGER_URL=http://alertmanager:9093
GRAFANA_DATASOURCE_URL=http://grafana-notifications:3000
HOME_ASSISTANT_WEBHOOK_URL=${HOME_ASSISTANT_WEBHOOK_URL}
PROMETHEUS_WEBHOOK_URL=http://webhook-receiver:8082/webhook/prometheus

# Notes:
# 1. Change all passwords and API keys in production
# 2. Configure proper SSL certificates for HTTPS
# 3. Set up channel configurations for your preferred notification methods
# 4. Adjust resource limits based on your hardware
# 5. Enable/disable optional services as needed
# 6. Configure backup and retention policies appropriately