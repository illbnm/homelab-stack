# Notifications Stack Configuration

DOMAIN=example.com
TZ=Asia/Shanghai

# ntfy (configured via config/ntfy/server.yml)
# After first start, create a user:
#   docker exec ntfy ntfy user add --role=admin admin

# Gotify
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASS=changeme-gotify-pass

# Alertmanager
# ALERTMANAGER_SLACK_WEBHOOK= (optional, for Slack routing)

# Unified notify.sh
NTFY_URL=https://ntfy.example.com
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=
NOTIFY_BACKEND=ntfy