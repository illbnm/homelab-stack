# Notification Stack — Environment Variables
# =============================================================================

# Domain for ntfy service
NTFY_DOMAIN=ntfy.${DOMAIN}

# Domain for Gotify service (backup)
GOTIFY_DOMAIN=gotify.${DOMAIN}

# Gotify admin password (first-run only, change after setup)
GOTIFY_ADMIN_PASSWORD=changeme

# ntfy access token (create via: docker exec ntfy ntfy user add admin)
# NTFY_TOKEN=

# Gotify app token (create via Gotify Web UI → Apps)
# GOTIFY_TOKEN=
