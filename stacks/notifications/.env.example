# =============================================================================
# HomeLab Stack — Notifications Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# Gotify admin credentials
GOTIFY_DEFAULTUSER=admin
GOTIFY_PASSWORD=changeme

# ntfy authentication
NTFY_AUTH_ENABLED=true

# ntfy auth token (generated after first setup, used by scripts/notify.sh)
# Run: scripts/notify-setup.sh to auto-generate
NTFY_TOKEN=
