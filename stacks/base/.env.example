# Base Stack
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# Traefik
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD_HASH=

# Portainer OAuth - created by scripts/authentik-setup.sh
# Portainer stores OAuth settings in its database, so apply these values in
# Portainer UI: Settings > Authentication > OAuth.
AUTHENTIK_DOMAIN=auth.yourdomain.com
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=
