# ==============================================================================
# Homelab Stack — Base Infrastructure Environment Variables
# ==============================================================================

DOMAIN=homelab.example.com
TZ=Asia/Shanghai

# Let's Encrypt ACME & Cloudflare DNS-01 Challenge
ACME_EMAIL=admin@homelab.example.com
CF_DNS_API_TOKEN=ChangeMe_CloudflareDnsApiToken_2026!

# Traefik Dashboard BasicAuth (Generate with: htpasswd -nb admin StrongPassword | sed -e s/\$/\$\$/g)
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$ChangeMeBcryptHashPlaceholder

# Watchtower Schedule & Notifications
WATCHTOWER_SCHEDULE=0 0 4 * * *
WATCHTOWER_LABEL_ENABLE=true
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=
