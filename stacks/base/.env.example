
# Domain configuration
DOMAIN=example.com

# ACME (Let's Encrypt) configuration
ACME_EMAIL=admin@example.com

# Traefik Basic Auth (htpasswd format)
# Generate with: htpasswd -nb admin securepassword
TRAEFIK_AUTH=admin:$apr1$hashedpassword

# Timezone
TZ=Asia/Shanghai

# Watchtower notification URL (optional)
# WATCHTOWER_NOTIFICATION_URL=ntfy://ntfy.example.com/watchtower
