# Base Stack — Environment Variables
# Copy to .env and fill ALL values before running.

DOMAIN=yourdomain.com
TZ=Asia/Shanghai
AUTHENTIK_DOMAIN=auth.${DOMAIN}

# Traefik Dashboard
# Generate password hash: echo $(htpasswd -nb admin PASSWORD) | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD_HASH=

# Portainer OAuth (filled by scripts/setup-authentik.sh)
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=
PORTAINER_OAUTH_ENDPOINT_AUTH=https://${AUTHENTIK_DOMAIN}/application/o/authorize/
PORTAINER_OAUTH_ENDPOINT_TOKEN=https://${AUTHENTIK_DOMAIN}/application/o/token/
PORTAINER_OAUTH_ENDPOINT_USERINFO=https://${AUTHENTIK_DOMAIN}/application/o/userinfo/
PORTAINER_OAUTH_SCOPES=openid profile email