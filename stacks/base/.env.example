# Base Stack Environment Variables

# The primary domain name for your homelab
DOMAIN=example.com

# Email used for Let's Encrypt certificates
ACME_EMAIL=admin@example.com

# Basic Auth credentials for the Traefik dashboard
# Generate it using: htpasswd -nb user password
# Or online at: https://hostingcanada.org/htpasswd-generator/
# Make sure to double any '$' signs (e.g. replace '$' with '$$') if using directly in compose,
# but in the .env file, single '$' is usually fine depending on docker compose version.
TRAEFIK_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj/

# Timezone
TZ=Asia/Shanghai
