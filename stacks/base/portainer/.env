import logging
import os
import stat
from pathlib import Path
from typing import Mapping

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
)
logger = logging.getLogger(__name__)

def _ensure_directory(path: Path) -> None:
    """Ensure the parent directory of *path* exists."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        logger.error("Failed to create directory %s: %s", path.parent, exc)
        raise

def _write_env_file(file_path: Path, variables: Mapping[str, str]) -> None:
    """Write environment variables to *file_path* with restrictive permissions.

    The file is created with mode 0o600 (read/write for owner only) to protect secrets.
    """
    try:
        with file_path.open("w", encoding="utf-8") as f:
            for key, value in variables.items():
                f.write(f"{key}={value}\n")
        # Set file permissions to owner read/write only
        file_path.chmod(stat.S_IRUSR | stat.S_IWUSR)
        logger.info("Environment file written to %s", file_path)
    except OSError as exc:
        logger.error("Failed to write environment file %s: %s", file_path, exc)
        raise

def generate_portainer_env(
    output_path: str,
    domain: str,
    client_id: str,
    client_secret: str,
    callback_url: str,
    logout_url: str,
) -> None:
    """Generate Portainer .env file for Authentik OAuth2 integration.

    Args:
        output_path: Destination path for the .env file.
        domain: Base domain used for Authentik (e.g., auth.example.com).
        client_id: OAuth2 client identifier issued by Authentik.
        client_secret: OAuth2 client secret issued by Authentik.
        callback_url: URL to which Portainer redirects after authentication.
        logout_url: URL to which Portainer redirects after logout.
    """
    env_vars: dict[str, str] = {
        "OAUTH2_CLIENT_ID": client_id,
        "OAUTH2_CLIENT_SECRET": client_secret,
        "OAUTH2_AUTH_URL": f"https://{domain}/application/o/authorize/",
        "OAUTH2_TOKEN_URL": f"https://{domain}/application/o/token/",
        "OAUTH2_USERINFO_URL": f"https://{domain}/application/o/userinfo/",
        "OAUTH2_REDIRECT_URL": callback_url,
        "OAUTH2_LOGOUT_URL": logout_url,
        "OAUTH2_SCOPES": "openid profile email",
    }

    target_file = Path(output_path).expanduser().resolve()
    _ensure_directory(target_file)
    _write_env_file(target_file, env_vars)

def _read_env(var_name: str) -> str:
    """Read an environment variable and raise a clear error if missing."""
    value = os.getenv(var_name)
    if not value:
        raise ValueError(f"Missing required environment variable: {var_name}")
    return value

def main() -> None:
    """Entry point: reads required configuration from environment variables and creates the Portainer .env file."""
    try:
        generate_portainer_env(
            output_path=_read_env("PORTAINER_ENV_PATH"),
            domain=_read_env("AUTHENTIK_DOMAIN"),
            client_id=_read_env("AUTHENTIK_CLIENT_ID"),
            client_secret=_read_env("AUTHENTIK_CLIENT_SECRET"),
            callback_url=_read_env("PORTAINER_CALLBACK_URL"),
            logout_url=_read_env("PORTAINER_LOGOUT_URL"),
        )
    except Exception as exc:
        logger.exception("Failed to generate Portainer environment file: %s", exc)

if __name__ == "__main__":
    main()
