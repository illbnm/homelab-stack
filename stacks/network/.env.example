# =============================================================================
# HomeLab Stack — Network Stack Environment Configuration
# Copy this file to .env in the stacks/network directory
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
PUID=1000
PGID=1000
DOMAIN=yourdomain.com              # Your base domain (e.g. home.example.com)

# -----------------------------------------------------------------------------
# WIREGUARD EASY (VPN Server)
# -----------------------------------------------------------------------------
WG_HOST=                           # Your public IP or domain (auto-detected if empty)
WG_PASSWORD=                       # REQUIRED: Web UI password for WireGuard Easy
WG_PORT=51820                      # WireGuard UDP port
WG_DEFAULT_ADDRESS=10.8.0.x       # Client IP range
WG_PEERS=5                         # Number of client peer configs to generate
WG_ALLOWEDIPS=0.0.0.0/0,::/0      # Routes to push to clients (0.0.0.0/0 = all traffic)

# -----------------------------------------------------------------------------
# CLOUDFLARE DDNS (Dynamic DNS)
# -----------------------------------------------------------------------------
CF_API_TOKEN=                      # REQUIRED: Cloudflare API token
CF_ZONE_ID=                        # REQUIRED: Cloudflare Zone ID
CF_RECORD_NAME=                    # DNS record to update (e.g., vpn.yourdomain.com)
