# ═══════════════════════════════════════════════════════════════════
# Network Stack — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai
DOMAIN=homelab.local

# ── AdGuard Home ──────────────────────────────────────────────────────
ADGUARD_HOST=adguard.homelab.local

# ── WireGuard Easy ────────────────────────────────────────────────────
# Required — your public VPN hostname or IP
WG_HOST=vpn.example.com

WG_PORT=51820
WG_DEFAULT_ADDRESS=10.8.0.x
WG_DEFAULT_DNS=10.8.0.1
WG_MTU=1420

# 0.0.0.0/0, ::/0 = full tunnel; 192.168.1.0/24, ::/0 = split tunnel
WG_ALLOWED_IPS=0.0.0.0/0, ::/0

WG_PERSISTENT_KEEPALIVE=25
WG_ENABLE_SPLIT_TUNNEL=false
WG_UI_HOST=wg.homelab.local

# Generate with: docker run --rm -it ghcr.io/wg-easy/wg-easy wg-easy hash
WG_PASSWORD_HASH=

# ── Cloudflare DDNS ───────────────────────────────────────────────────
CF_API_EMAIL=cloudflare@example.com
CF_API_KEY=your_cloudflare_api_token_here

# JSON: [{"zone":"example.com","records":["home","vpn"]}]
CF_ZONES=[{"zone":"example.com","records":["home"]}]

# true = proxied (orange cloud), false = DNS-only (grey cloud)
CF_PROXIED=false
