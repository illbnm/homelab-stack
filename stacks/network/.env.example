# ─── Timezone ───────────────────────────────────────────
TZ=Asia/Shanghai

# ─── Domain ────────────────────────────────────────────
DOMAIN=your-domain.com

# ─── WireGuard ─────────────────────────────────────────
WG_HOST=wg.your-domain.com
WG_PASSWORD=changeme
WG_DNS=192.168.1.2
WG_ALLOWED_IPS=0.0.0.0/0, ::/0

# ─── Cloudflare DDNS ───────────────────────────────────
CF_API_TOKEN=your_cloudflare_api_token
CF_DOMAINS=example.com,www.example.com

# ─── Unbound ───────────────────────────────────────────
# Uses default config — customize via volume mount at unbound-data
