# Network Stack Environment Configuration
# ======================================

# WireGuard Configuration
WIREGUARD_SERVER_URL=auto
WIREGUARD_SERVER_PORT=51820
WIREGUARD_PEERS=10
WIREGUARD_PEER_DNS=172.21.0.10
WIREGUARD_SUBNET=10.13.13.0
WIREGUARD_ALLOWED_IPS=0.0.0.0/0

# Traefik Configuration
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DASHBOARD_DOMAIN=traefik.local
TRAEFIK_BASIC_AUTH=admin:$apr1$vVO3/3CA$f8WZGzM/OLyYp6mRc0GKP1

# Pi-hole Configuration (Optional)
PIHOLE_WEB_PASSWORD=changeme_CHANGE_IN_PRODUCTION
PIHOLE_REV_SERVER_TARGET=
PIHOLE_REV_SERVER_DOMAIN=
PIHOLE_REV_SERVER_CIDR=

# Netdata Configuration
NETDATA_CLAIM_URL=https://app.netdata.cloud
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# Network Configuration
NETWORK_STACK_SUBNET=172.21.0.0/24
NETWORK_STACK_GATEWAY=172.21.0.1

# DNS Configuration
PRIMARY_DNS_SERVER=172.21.0.10  # AdGuard Home
SECONDARY_DNS_SERVER=172.21.0.20  # Unbound
UPSTREAM_DNS_SERVERS=1.1.1.1,8.8.8.8,9.9.9.9

# Security Configuration
ENABLE_DNSSEC=true
ENABLE_DNS_OVER_TLS=true
ENABLE_DNS_OVER_HTTPS=true
ENABLE_QUIC=true

# Performance Configuration
DNS_CACHE_SIZE=256M
UNBOUND_THREADS=4
ADGUARD_QUERY_LOG_RETENTION=24h
WIREGUARD_MTU=1420

# Resource Limits
ADGUARD_CPU_LIMIT=1.0
ADGUARD_MEMORY_LIMIT=512M
UNBOUND_CPU_LIMIT=0.5
UNBOUND_MEMORY_LIMIT=256M
WIREGUARD_CPU_LIMIT=0.3
WIREGUARD_MEMORY_LIMIT=128M
TRAEFIK_CPU_LIMIT=0.5
TRAEFIK_MEMORY_LIMIT=256M

# Monitoring Configuration
NETDATA_ENABLED=true
SMOKEPING_ENABLED=true
NODE_EXPORTER_ENABLED=true
PROMETHEUS_SCRAPE_INTERVAL=15s

# Backup Configuration
BACKUP_SCHEDULE="0 3 * * *"  # Daily at 3 AM
BACKUP_RETENTION_DAYS=30
ENCRYPT_BACKUPS=true

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_ROTATION_SIZE=100M
ENABLE_AUDIT_LOGS=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Feature Flags
ENABLE_ADGUARD=true
ENABLE_UNBOUND=true
ENABLE_WIREGUARD=true
ENABLE_TRAEFIK=true
ENABLE_PIHOLE=false  # Disabled by default (conflicts with AdGuard)
ENABLE_NETDATA=true
ENABLE_SMOKEPING=true

# Integration Configuration
PROMETHEUS_TARGETS=172.21.0.80:9100,172.21.0.50:19999
GRAFANA_DASHBOARDS_ENABLED=true
ALERTMANAGER_ENABLED=false

# Notes:
# 1. Change all passwords and tokens in production
# 2. Configure ACME email for valid TLS certificates
# 3. Adjust resource limits based on your hardware
# 4. Enable/disable services based on your needs
# 5. Set proper domain names for Traefik