# =============================================================================
# HomeLab Stack — Network Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com

# -----------------------------------------------------------------------------
# WIREGUARD EASY
# WG_HOST: Your server's public IP or domain (required for client configs)
# WG_PASSWORD: Web UI admin password
# WG_PORT: UDP port for WireGuard traffic (default 51820)
# -----------------------------------------------------------------------------
WG_HOST=your.public.ip.or.domain
WG_PASSWORD=CHANGE_ME_WG_PASSWORD
WG_PORT=51820

# -----------------------------------------------------------------------------
# CLOUDFLARE DDNS
# CF_API_TOKEN: Create at https://dash.cloudflare.com/profile/api-tokens
#   Required permissions: Zone:DNS:Edit for your domain
# CF_DOMAINS: Comma-separated domains to update (e.g. home.example.com,*.home.example.com)
# CF_RECORD_TYPE: A (IPv4 only), AAAA (IPv6 only), or both (comma-separated)
# -----------------------------------------------------------------------------
CF_API_TOKEN=CHANGE_ME_CF_API_TOKEN
CF_DOMAINS=home.example.com
CF_RECORD_TYPE=A
CF_PROXIED=false

# Multiple domains example:
# CF_DOMAINS=home.example.com,*.home.example.com
# CF_RECORD_TYPE=A,AAAA
