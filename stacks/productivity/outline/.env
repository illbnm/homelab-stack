import logging
import os
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Optional
from urllib.parse import urlparse

from dotenv import dotenv_values

# Configure logger
logger = logging.getLogger(__name__)
if not logger.handlers:
    handler = logging.StreamHandler(sys.stdout)
    formatter = logging.Formatter(
        fmt="%(asctime)s %(levelname)s %(name)s - %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    handler.setFormatter(formatter)
    logger.addHandler(handler)
logger.setLevel(logging.INFO)


@dataclass(frozen=True)
class OutlineEnvConfig:
    """Configuration loaded from stacks/productivity/outline/.env."""

    oidc_client_id: str
    oidc_client_secret: str
    oidc_issuer_url: str
    outline_url: str
    database_url: Optional[str] = None
    redis_url: Optional[str] = None

    @staticmethod
    def _validate_non_empty(name: str, value: str) -> None:
        if not value:
            raise ValueError(f"Environment variable '{name}' must not be empty.")

    @staticmethod
    def _validate_url(name: str, value: str) -> None:
        parsed = urlparse(value)
        if not all([parsed.scheme, parsed.netloc]):
            raise ValueError(f"Environment variable '{name}' must be a valid URL, got '{value}'.")

    @classmethod
    def from_dict(cls, data: dict) -> "OutlineEnvConfig":
        """Create a validated config from a dict of environment variables."""
        oidc_client_id = data.get("OIDC_CLIENT_ID", "")
        oidc_client_secret = data.get("OIDC_CLIENT_SECRET", "")
        oidc_issuer_url = data.get("OIDC_ISSUER_URL", "")
        outline_url = data.get("OUTLINE_URL", "")
        database_url = data.get("DATABASE_URL")
        redis_url = data.get("REDIS_URL")

        # Validate required fields
        cls._validate_non_empty("OIDC_CLIENT_ID", oidc_client_id)
        cls._validate_non_empty("OIDC_CLIENT_SECRET", oidc_client_secret)
        cls._validate_non_empty("OIDC_ISSUER_URL", oidc_issuer_url)
        cls._validate_non_empty("OUTLINE_URL", outline_url)

        # Validate URL format
        cls._validate_url("OIDC_ISSUER_URL", oidc_issuer_url)
        cls._validate_url("OUTLINE_URL", outline_url)
        if database_url:
            cls._validate_url("DATABASE_URL", database_url)
        if redis_url:
            cls._validate_url("REDIS_URL", redis_url)

        return cls(
            oidc_client_id=oidc_client_id,
            oidc_client_secret=oidc_client_secret,
            oidc_issuer_url=oidc_issuer_url,
            outline_url=outline_url,
            database_url=database_url,
            redis_url=redis_url,
        )


def load_outline_env(env_path: Path) -> OutlineEnvConfig:
    """Load and validate the Outline service .env file.

    Args:
        env_path: Path to the .env file.

    Returns:
        An instance of OutlineEnvConfig with validated values.

    Raises:
        FileNotFoundError: If the .env file does not exist.
        ValueError: If validation fails.
    """
    if not env_path.is_file():
        raise FileNotFoundError(f".env file not found at {env_path}")

    logger.info("Loading environment variables from %s", env_path)
    raw_data = dotenv_values(env_path)

    config = OutlineEnvConfig.from_dict(raw_data)
    logger.info("Successfully loaded and validated Outline environment configuration")
    return config


def main() -> None:
    """Entry point for the script."""
    # Resolve the .env file relative to this script's location.
    env_file = Path(__file__).resolve().parent / "stacks" / "productivity" / "outline" / ".env"
    try:
        config = load_outline_env(env_file)
        # Export configuration as environment variables for downstream processes
        for key, value in vars(config).items():
            os.environ[key.upper()] = str(value)
        logger.debug("Exported configuration to process environment")
    except Exception as exc:
        logger.error("Failed to load Outline environment: %s", exc)
        sys.exit(1)


if __name__ == "__main__":
    main()