#!/usr/bin/env python3
"""
Generate a Gitea .env file with OIDC client credentials.

The script reads a JSON configuration file containing the required
parameters and writes a Docker‑compatible ``.env`` file for the
Gitea service.  It supports a ``--dry-run`` mode that prints the
result instead of writing it to disk.

Typical usage:
    python generate_gitea_env.py --config config.json
    python generate_gitea_env.py --config config.json --dry-run
"""

import argparse
import json
import logging
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import List

LOGGER = logging.getLogger(__name__)
LOGGER.setLevel(logging.WARNING)  # Default to WARNING; use --verbose for DEBUG
handler = logging.StreamHandler(sys.stdout)
formatter = logging.Formatter("%(asctime)s %(levelname)s %(message)s")
handler.setFormatter(formatter)
LOGGER.addHandler(handler)


@dataclass(frozen=True)
class OIDCConfig:
    """Configuration required for Gitea OIDC integration."""
    client_id: str
    client_secret: str
    redirect_uris: List[str]

    @classmethod
    def from_dict(cls, data: dict) -> "OIDCConfig":
        """Create an instance from a dictionary, validating fields."""
        missing = [k for k in ("client_id", "client_secret", "redirect_uris") if k not in data]
        if missing:
            raise ValueError(f"Missing required keys in config: {', '.join(missing)}")
        if not isinstance(data["redirect_uris"], list) or not all(isinstance(u, str) for u in data["redirect_uris"]):
            raise TypeError("redirect_uris must be a list of strings")
        return cls(
            client_id=str(data["client_id"]),
            client_secret=str(data["client_secret"]),
            redirect_uris=[str(u) for u in data["redirect_uris"]],
        )

    def to_env(self) -> str:
        """Render the configuration as a .env file content."""
        lines = [
            f"GITEA_OIDC_CLIENT_ID={self.client_id}",
            f"GITEA_OIDC_CLIENT_SECRET={self.client_secret}",
            f"GITEA_OIDC_REDIRECT_URIS={','.join(self.redirect_uris)}",
        ]
        return "\n".join(lines) + "\n"


def load_config(path: Path) -> OIDCConfig:
    """Read and parse the JSON configuration file."""
    try:
        raw = path.read_text(encoding="utf-8")
        data = json.loads(raw)
        LOGGER.debug("Configuration loaded from %s", path)
        return OIDCConfig.from_dict(data)
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Failed to read config file {path}: {exc}") from exc


def write_env(content: str, destination: Path, dry_run: bool) -> None:
    """Write the .env content to the destination file.

    In dry‑run mode the content is logged at DEBUG level with the client_secret masked.
    """
    if dry_run:
        # Mask the client_secret before logging to avoid accidental exposure
        masked_content = "\n".join(
            [line if not line.startswith("GITEA_OIDC_CLIENT_SECRET") else "GITEA_OIDC_CLIENT_SECRET=***" for line in content.splitlines()]
        ) + "\n"
        LOGGER.debug("Dry‑run mode – output:\n%s", masked_content)
        return
    try:
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(content, encoding="utf-8")
        # Restrict permissions to owner‑only (rw-------) for security
        destination.chmod(0o600)
        LOGGER.info("Successfully wrote .env to %s", destination)
    except OSError as exc:
        raise RuntimeError(f"Failed to write .env file {destination}: {exc}") from exc


def parse_args() -> argparse.Namespace:
    """Parse command‑line arguments."""
    parser = argparse.ArgumentParser(description="Generate Gitea OIDC .env file")
    parser.add_argument(
        "--config",
        type=Path,
        required=True,
        help="Path to JSON configuration file with client_id, client_secret, redirect_uris",
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("stacks/productivity/gitea/.env"),
        help="Destination .env file path (default: stacks/productivity/gitea/.env)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the generated .env content without writing to disk",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable debug logging",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.verbose:
        LOGGER.setLevel(logging.DEBUG)

    try:
        config = load_config(args.config)
        env_content = config.to_env()
        write_env(env_content, args.output, args.dry_run)
    except Exception as exc:
        LOGGER.error("Error: %s", exc)
        sys.exit(1)


if __name__ == "__main__":
    main()
