# Productivity Stack Environment Variables
# Copy this file to .env and fill in the values

# ==================== Global ====================
DOMAIN=example.com

# ==================== PostgreSQL Superuser ====================
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=change_me_postgres_super_password

# ==================== Redis ====================
REDIS_PASSWORD=change_me_redis_password

# ==================== Gitea ====================
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change_me_gitea_db_password
GITEA_SECRET_KEY=change_me_gitea_secret_key_min_32_chars

# ==================== Vaultwarden ====================
VAULTWARDEN_ADMIN_TOKEN=change_me_vaultwarden_admin_token_strong

# SMTP Configuration (Optional but recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ==================== Outline ====================
OUTLINE_DB_NAME=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=change_me_outline_db_password
OUTLINE_SECRET_KEY=change_me_outline_secret_key_min_32_chars
OUTLINE_UTILS_SECRET=change_me_outline_utils_secret_min_32_chars

# OIDC Configuration (from Authentik)
OUTLINE_OIDC_CLIENT_ID=your-outline-client-id
OUTLINE_OIDC_CLIENT_SECRET=your-outline-client-secret

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root_password_strong

# ==================== Security Notes ====================
# 1. Generate strong passwords: openssl rand -base64 32
# 2. GITEA_SECRET_KEY must be at least 32 characters
# 3. OUTLINE_SECRET_KEY and OUTLINE_UTILS_SECRET must be at least 32 characters
# 4. VAULTWARDEN_ADMIN_TOKEN should be very strong
# 5. Never commit .env to version control
