# Productivity Stack Environment Variables
# Copy this file to .env and fill in your values

# Domain configuration
DOMAIN=example.com

# Timezone
TZ=Asia/Shanghai

# Gitea
GITEA_DB_PASSWORD=change_me_gitea_db_password
GITEA_OAUTH2_JWT_SECRET=change_me_gitea_oauth2_jwt_secret

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=change_me_vaultwarden_admin_token
VAULTWARDEN_DB_PASSWORD=change_me_vaultwarden_db_password

# Outline
OUTLINE_SECRET_KEY=change_me_outline_secret_key
OUTLINE_UTILS_SECRET=change_me_outline_utils_secret
OUTLINE_DB_PASSWORD=change_me_outline_db_password
OUTLINE_OAUTH_CLIENT_ID=change_me_outline_oauth_client_id
OUTLINE_OAUTH_CLIENT_SECRET=change_me_outline_oauth_client_secret

# BookStack
BOOKSTACK_APP_KEY=change_me_bookstack_app_key
BOOKSTACK_DB_PASSWORD=change_me_bookstack_db_password
BOOKSTACK_OIDC_CLIENT_ID=change_me_bookstack_oidc_client_id
BOOKSTACK_OIDC_CLIENT_SECRET=change_me_bookstack_oidc_client_secret
BOOKSTACK_AUTH_METHOD=standard

# Stirling PDF
# (No additional environment variables required for basic setup)
