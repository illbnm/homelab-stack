# ============================================================
# Productivity Stack — Environment Variables
# Copy to .env and fill ALL values before running:
#   cp .env.example .env
# ============================================================

# ── Global ───────────────────────────────────────────────────
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# ── Authentik SSO (from SSO stack) ──────────────────────────
AUTHENTIK_DOMAIN=auth.yourdomain.com

# ── Shared PostgreSQL (from databases stack) ─────────────────
GITEA_DB_PASSWORD=CHANGE_ME
VAULTWARDEN_DB_PASSWORD=CHANGE_ME
OUTLINE_DB_PASSWORD=CHANGE_ME

# ── Shared MariaDB (from databases stack) ────────────────────
BOOKSTACK_DB_PASSWORD=CHANGE_ME

# ── Shared Redis (from databases stack) ──────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Generate secrets with: openssl rand -hex 32 ──────────────
GITEA_OAUTH2_JWT_SECRET=CHANGE_ME
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME
OUTLINE_SECRET_KEY=CHANGE_ME
OUTLINE_UTILS_SECRET=CHANGE_ME

# ── BookStack APP_KEY ────────────────────────────────────────
# Generate: echo "base64:$(openssl rand -base64 32)"
BOOKSTACK_APP_KEY=base64:CHANGE_ME

# ── BookStack Auth Method ────────────────────────────────────
# Set to 'oidc' to enable Authentik SSO (requires OIDC vars below)
BOOKSTACK_AUTH_METHOD=standard

# ── OAuth2 / OIDC Client Credentials ─────────────────────────
# Filled by scripts/setup-authentik.sh or manually in Authentik
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=
BOOKSTACK_OIDC_CLIENT_ID=
BOOKSTACK_OIDC_CLIENT_SECRET=

# ── SMTP (shared across Gitea, Vaultwarden, Outline) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=starttls

# ── Per-service SMTP senders (optional) ──────────────────────
GITEA_SMTP_ENABLED=false
GITEA_SMTP_FROM=noreply@yourdomain.com
VAULTWARDEN_SMTP_FROM=vault@yourdomain.com
OUTLINE_SMTP_FROM=docs@yourdomain.com

# ── MinIO / S3 Storage (optional, for Outline) ──────────────
# Set OUTLINE_FILE_STORAGE=s3 to enable
OUTLINE_FILE_STORAGE=local
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=https://minio.yourdomain.com
OUTLINE_S3_BUCKET=outline
