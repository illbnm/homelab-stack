# =============================================================================
# HomeLab Stack — Productivity Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# AUTHENTIK (SSO) — domain for OIDC endpoints
# Must match AUTHENTIK_DOMAIN in SSO stack
# -----------------------------------------------------------------------------
AUTHENTIK_DOMAIN=auth.yourdomain.com

# -----------------------------------------------------------------------------
# DATABASE PASSWORDS — must match databases stack .env
# -----------------------------------------------------------------------------
GITEA_DB_PASSWORD=CHANGE_ME_GITEA_DB
VAULTWARDEN_DB_PASSWORD=CHANGE_ME_VAULTWARDEN_DB
OUTLINE_DB_PASSWORD=CHANGE_ME_OUTLINE_DB
BOOKSTACK_DB_PASSWORD=CHANGE_ME_BOOKSTACK_DB
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# GITEA
# Generate secrets: openssl rand -hex 32
# GITEA_RUNNER_TOKEN: Get from Gitea → Settings → Actions → Runners → New
# -----------------------------------------------------------------------------
GITEA_SECRET_KEY=CHANGE_ME_GITEA_SECRET
GITEA_OAUTH2_JWT_SECRET=CHANGE_ME_GITEA_OAUTH_JWT
GITEA_RUNNER_TOKEN=CHANGE_ME_RUNNER_TOKEN

# -----------------------------------------------------------------------------
# VAULTWARDEN
# ADMIN_TOKEN: openssl rand -base64 48
# SMTP is required for 2FA and email verification
# -----------------------------------------------------------------------------
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_VAULTWARDEN_ADMIN

# SMTP (required for 2FA invitations)
SMTP_HOST=smtp.example.com
SMTP_FROM=noreply@example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# OUTLINE
# Generate secrets: openssl rand -hex 32
# OAuth2 credentials: set by scripts/setup-authentik.sh
# -----------------------------------------------------------------------------
OUTLINE_SECRET_KEY=CHANGE_ME_OUTLINE_SECRET
OUTLINE_UTILS_SECRET=CHANGE_ME_OUTLINE_UTILS
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# BOOKSTACK
# APP_KEY: echo "base64:$(openssl rand -base64 32)"
# Set BOOKSTACK_AUTH_METHOD=oidc to enable SSO
# -----------------------------------------------------------------------------
BOOKSTACK_APP_KEY=base64:CHANGE_ME_BOOKSTACK_APP_KEY
BOOKSTACK_AUTH_METHOD=standard
BOOKSTACK_OIDC_CLIENT_ID=
BOOKSTACK_OIDC_CLIENT_SECRET=
