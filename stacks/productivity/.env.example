# HomeLab Productivity Stack Environment Template
DOMAIN=lab.example.com
PUID=1000
PGID=1000
TZ=Asia/Shanghai
DATA_ROOT=/data/productivity

# Gitea & Runner
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change_me_gitea_db_password
GITEA_RUNNER_TOKEN=change_me_gitea_runner_token

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=change_me_argon2_vaultwarden_admin_token
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notify@example.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=vault@lab.example.com

# Outline Wiki
OUTLINE_SECRET_KEY=change_me_64_hex_outline_secret_key
OUTLINE_UTILS_SECRET=change_me_64_hex_outline_utils_secret
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=change_me_outline_db_password
OUTLINE_DB_NAME=outline
OUTLINE_S3_BUCKET=outline-assets
OUTLINE_OIDC_CLIENT_ID=outline-client-id
OUTLINE_OIDC_CLIENT_SECRET=change_me_outline_oidc_secret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root_password

# BookStack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=change_me_bookstack_db_password
BOOKSTACK_DB_NAME=bookstackapp
BOOKSTACK_OIDC_CLIENT_ID=bookstack-client-id
BOOKSTACK_OIDC_CLIENT_SECRET=change_me_bookstack_oidc_secret
