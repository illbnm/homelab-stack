# Productivity Stack — Environment Variables
GIT_DOMAIN=git.${DOMAIN}
VAULT_DOMAIN=vault.${DOMAIN}
OUTLINE_DOMAIN=wiki.${DOMAIN}
PDF_DOMAIN=pdf.${DOMAIN}

GITEA_DB_PASSWORD=CHANGE_ME
OUTLINE_DB_PASSWORD=CHANGE_ME
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_GENERATE_64_CHARS
OUTLINE_SECRET_KEY=CHANGE_ME_GENERATE_64_CHARS
