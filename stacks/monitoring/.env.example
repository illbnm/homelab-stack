# Monitoring Stack Environment Variables
# Copy this file to .env in the root directory and fill in the values

# Domain Configuration
DOMAIN=localhost

# Authentik SSO Configuration
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=

# Grafana OnCall Configuration
GRAFANA_ONCALL_TOKEN=
ONCALL_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
POSTGRES_USER=oncall
POSTGRES_PASSWORD=CHANGE_ME
FLOWER_BASIC_AUTH=user:password

# Slack Integration (Optional)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Telegram Integration (Optional)
TELEGRAM_TOKEN=
