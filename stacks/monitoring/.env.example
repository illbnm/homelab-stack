# Monitoring Stack Environment Variables

# General
TZ=Asia/Shanghai
DOMAIN=example.com

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=

# Authentik SSO (required for OAuth)
AUTHENTIK_DOMAIN=sso.example.com

# Uptime Kuma
UPTIME_KUMA_DOMAIN=uptime.example.com
