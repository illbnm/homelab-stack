# Monitoring Stack env — copy root .env, values below are stack-specific

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Grafana OIDC (Authentik)
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Domain
DOMAIN=localhost

# Data Retention
PROMETHEUS_RETENTION=30d
LOKI_RETENTION=7d
TEMPO_RETENTION=3d

# Grafana OnCall
ONCALL_SECRET_KEY=CHANGE_ME_RANDOM_STRING

# Alertmanager (ntfy integration)
NTFY_TOKEN= # Optional: Bearer token for ntfy if auth is enabled

# Uptime Kuma
UPTIME_KUMA_ADMIN=admin
UPTIME_KUMA_PASSWORD=CHANGE_ME
UPTIME_KUMA_URL=http://uptime-kuma:3001

# ntfy notification endpoint
NTFY_URL=http://ntfy:80
