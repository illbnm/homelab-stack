# =============================================================================
# Monitoring Stack - Environment Variables
# =============================================================================

DOMAIN=localhost
TZ=Asia/Shanghai

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=            # REQUIRED: strong password

# Authentik SSO (optional)
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Retention Policies
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
TEMPO_RETENTION=72h

# Grafana OnCall
ONCALL_SECRET_KEY=                 # REQUIRED: openssl rand -base64 32
