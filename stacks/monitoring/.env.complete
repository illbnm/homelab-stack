# =============================================================================
# Observability Stack - Example Environment File
# Copy to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# GRAFANA
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# OAuth2 Configuration (from Authentik)
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=

# Authentik Domain
AUTHENTIK_DOMAIN=auth.yourdomain.com

# -----------------------------------------------------------------------------
# RETENTION POLICIES
# -----------------------------------------------------------------------------
# Prometheus metrics retention
PROMETHEUS_RETENTION=30d

# Loki logs retention
LOKI_RETENTION=168h

# Tempo traces retention
TEMPO_RETENTION=72h

# -----------------------------------------------------------------------------
# GRAFANA ONCALL (Optional)
# -----------------------------------------------------------------------------
ONCALL_SECRET_KEY=CHANGE_ME_RANDOM_STRING

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING (Optional)
# -----------------------------------------------------------------------------
# Prometheus scrape interval (default: 15s)
PROMETHEUS_SCRAPE_INTERVAL=15s

# Prometheus evaluation interval (default: 15s)
PROMETHEUS_EVALUATION_INTERVAL=15s

# Loki chunk size (default: 1MB)
LOKI_CHUNK_SIZE=1MB

# Tempo block retention (default: 72h)
TEMPO_BLOCK_RETENTION=72h

# -----------------------------------------------------------------------------
# ALERTING (Optional)
# -----------------------------------------------------------------------------
# Alertmanager Slack webhook (optional)
ALERTMANAGER_SLACK_WEBHOOK=

# Alertmanager Discord webhook (optional)
ALERTMANAGER_DISCORD_WEBHOOK=

# Alertmanager email configuration (optional)
ALERTMANAGER_SMTP_HOST=
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_SMTP_FROM=

# -----------------------------------------------------------------------------
# RESOURCE LIMITS (Optional)
# -----------------------------------------------------------------------------
# Prometheus memory limit (default: unlimited)
PROMETHEUS_MEMORY_LIMIT=2g

# Grafana memory limit (default: unlimited)
GRAFANA_MEMORY_LIMIT=512m

# Loki memory limit (default: unlimited)
LOKI_MEMORY_LIMIT=1g

# Tempo memory limit (default: unlimited)
TEMPO_MEMORY_LIMIT=512m

# -----------------------------------------------------------------------------
# STORAGE PATHS (Optional - defaults to Docker volumes)
# -----------------------------------------------------------------------------
# Uncomment to use host paths instead of Docker volumes
# PROMETHEUS_DATA_PATH=/opt/homelab/prometheus/data
# GRAFANA_DATA_PATH=/opt/homelab/grafana/data
# LOKI_DATA_PATH=/opt/homelab/loki/data
# TEMPO_DATA_PATH=/opt/homelab/tempo/data
# ALERTMANAGER_DATA_PATH=/opt/homelab/alertmanager/data
# UPTIME_KUMA_DATA_PATH=/opt/homelab/uptime-kuma/data

# -----------------------------------------------------------------------------
# NETWORK (Optional)
# -----------------------------------------------------------------------------
# Uncomment if you want to use custom network names
# MONITORING_NETWORK_NAME=monitoring
# PROXY_NETWORK_NAME=proxy

# -----------------------------------------------------------------------------
# SECURITY (Optional)
# -----------------------------------------------------------------------------
# Enable anonymous access to Grafana (not recommended)
GF_AUTH_ANONYMOUS_ENABLED=false

# Allow embedding Grafana in iframes
GF_SECURITY_ALLOW_EMBEDDING=false

# Cookie secure flag (set to true for HTTPS)
GF_SECURITY_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# LOGGING (Optional)
# -----------------------------------------------------------------------------
# Log level for services (debug, info, warn, error)
PROMETHEUS_LOG_LEVEL=info
GRAFANA_LOG_LEVEL=info
LOKI_LOG_LEVEL=warn
TEMPO_LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# CN MIRROR (For users in China)
# -----------------------------------------------------------------------------
# Uncomment to use CN mirrors for Docker images
# CN_MODE=true
# CN_DOCKER_MIRROR=https://docker.m.daocloud.io
