# Media Stack — Environment Variables
# Copy to .env and fill ALL values before running.

TZ=Asia/Shanghai
DOMAIN=yourdomain.com

# UID/GID for file permissions
PUID=1000
PGID=1000

# Local paths for media and downloads
# IMPORTANT: These must be on the same filesystem for hardlinks to work
MEDIA_PATH=/data/media
DOWNLOAD_PATH=/data/torrents

# Directory structure:
# /data/
# ├── torrents/        ← DOWNLOAD_PATH
# │   ├── movies/
# │   └── tv/
# └── media/           ← MEDIA_PATH
#     ├── movies/
#     └── tv/
