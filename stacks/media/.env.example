# ============================================================
# Media Stack — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- Domain (used for Traefik subdomains) ---
DOMAIN=yourdomain.com

# --- User / Group IDs ---
# Run `id` to find your UID/GID (typically 1000 for first user)
PUID=1000
PGID=1000

# --- Timezone ---
TZ=America/New_York

# --- TRaSH Guides Directory Structure ---
# Root directory for all media
MEDIA_ROOT=/data/media
# Root directory for completed downloads
DOWNLOADS_ROOT=/data/torrents

# --- Service Ports (defaults shown) ---
# qBittorrent WebUI
QBITTORRENT_PORT=8080

# --- Service Passwords / Secrets ---
# Generate strong passwords: openssl rand -base64 32
JELLYFIN_ADMIN_PASSWORD=

# -------------------------------------------------------
# REQUIRED: Create /data directory structure:
#
#   /data/
#   ├── media/
#   │   ├── movies/       ← Radarr imports here (hardlinks)
#   │   └── tv/           ← Sonarr imports here (hardlinks)
#   └── torrents/
#       ├── movies/       ← qBittorrent category: movies
#       └── tv/           ← qBittorrent category: tv
#
# Both MEDIA_ROOT and DOWNLOADS_ROOT must be on the SAME
# filesystem/volume for hardlinks to work (TRaSH Guides).
# -------------------------------------------------------
