# =============================================================================
# Media Stack — Environment Variables
# =============================================================================
# Copy this file to .env and edit:
#   cp .env.example .env

# --- System ---
TZ=UTC
PUID=1000
PGID=1000

# --- Domain ---
# Base domain for Traefik routing (e.g. example.com)
DOMAIN=localhost

# --- Data Paths ---
# TRaSH Guides structure: all services share one root for hardlinks
#   /data/
#   ├── torrents/
#   │   ├── movies/
#   │   └── tv/
#   └── media/
#       ├── movies/
#       └── tv/
DATA_ROOT=/data
