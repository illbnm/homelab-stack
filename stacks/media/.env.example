# Domain
DOMAIN=example.com

# User/Group IDs — run `id` to find yours
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# Data paths (TRaSH Guides hardlink layout)
DATA_ROOT=/data

# Jellyfin
JELLYFIN_PublishedServerUrl=https://jellyfin.example.com

# qBittorrent
QBITTORRENT_WEBUI_PORT=8080

# Jellyseerr
JELLYSEERR_PORT=5055

# Authentik Forward Auth (optional, leave empty to disable)
AUTHENTIK_HOST=
AUTHENTIK_TOKEN=
