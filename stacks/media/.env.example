# =============================================================================
# HomeLab Stack — Media Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# MEDIA PATHS
# Follow TRaSH Guides hardlink layout:
#   /data/
#   ├── torrents/     ← qBittorrent downloads (inside container: /data/torrents)
#   │   ├── movies/
#   │   └── tv/
#   └── media/        ← Jellyfin library (inside container: /data/media)
#       ├── movies/
#       └── tv/
# -----------------------------------------------------------------------------
MEDIA_ROOT=/opt/homelab/media
