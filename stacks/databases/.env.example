# =============================================================================
# HomeLab Stack — Databases Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ROOT CREDENTIALS
# -----------------------------------------------------------------------------
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=CHANGE_ME_POSTGRES_ROOT
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT

# -----------------------------------------------------------------------------
# PER-SERVICE DATABASE PASSWORDS
# Used by init scripts to create users + databases
# Must match the corresponding variable in each stack's .env
# -----------------------------------------------------------------------------
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB
GITEA_DB_PASSWORD=CHANGE_ME_GITEA_DB
OUTLINE_DB_PASSWORD=CHANGE_ME_OUTLINE_DB
VAULTWARDEN_DB_PASSWORD=CHANGE_ME_VAULTWARDEN_DB
AUTHENTIK_DB_PASSWORD=CHANGE_ME_AUTHENTIK_DB
GRAFANA_DB_PASSWORD=CHANGE_ME_GRAFANA_DB
BOOKSTACK_DB_PASSWORD=CHANGE_ME_BOOKSTACK_DB

# -----------------------------------------------------------------------------
# PGADMIN
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
