# Storage Stack Environment Variables
# Copy this file to .env and fill in the values

# ==================== Global ====================
DOMAIN=example.com
PUID=1000
PGID=1000

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_root_password_strong

# ==================== Directory Paths ====================
# Ensure these directories exist and have correct permissions:
# sudo mkdir -p /data/{nfs,sync,minio}
# sudo chown -R ${PUID}:${PGID} /data

# ==================== Security Notes ====================
# 1. Generate strong passwords: openssl rand -base64 32
# 2. MINIO_ROOT_PASSWORD should be very strong
# 3. Never commit .env to version control
