# =============================================================================
# HomeLab Stack — Storage Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env && nano .env
# =============================================================================

# General
DOMAIN=yourdomain.com
TZ=Asia/Shanghai
PUID=1000
PGID=1000

# Default phone region for Nextcloud (ISO 3166-1)
DEFAULT_PHONE_REGION=CN

# =============================================================================
# Nextcloud
# =============================================================================
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Database credentials (must match databases stack)
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_MASTER

# Redis password (shared with databases stack)
REDIS_PASSWORD=CHANGE_ME_REDIS

# =============================================================================
# Authentik OIDC (optional — for SSO login)
# Create an application + provider in Authentik first
# Then fill in these values:
# =============================================================================
AUTHENTIK_DOMAIN=auth.yourdomain.com
# NEXTCLOUD_OIDC_CLIENT_ID=
# NEXTCLOUD_OIDC_CLIENT_SECRET=

# =============================================================================
# MinIO — Object Storage
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# =============================================================================
# FileBrowser & Syncthing
# =============================================================================
# Host path to shared storage root
STORAGE_ROOT=/data
