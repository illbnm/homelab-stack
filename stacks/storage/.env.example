# Storage Stack Environment Variables

# Base Domain
DOMAIN=example.com

# Timezone
TZ=Asia/Shanghai

# Shared Databases Passwords (must match your stacks/databases/.env)
NEXTCLOUD_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Nextcloud Config
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_SECURE
NEXTCLOUD_DOMAIN=cloud.example.com

# MinIO Config
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_SECURE_S3

# Physical Storage Path on Host
# Where FileBrowser and Syncthing will read/write
STORAGE_ROOT=/data/storage
