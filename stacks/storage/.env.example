# ============================
# Storage Stack Environment Variables (copy to root .env if needed)
# ============================

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-strong-password
NEXTCLOUD_DB_HOST=homelab-postgres
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change-me-db-password
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# FileBrowser
FILEBROWSER_USER=admin
FILEBROWSER_PASSWORD=change-me-filebrowser-password

# Syncthing
SYNCTHING_API_KEY=
