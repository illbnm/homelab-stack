# =============================================================================
# HomeLab Stack — Storage Stack Environment
# Copy this file to .env and fill in your values
# Run: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
TZ=Asia/Shanghai
DOMAIN=yourdomain.com
PUID=1000
PGID=1000

# -----------------------------------------------------------------------------
# NEXTCLOUD
# NEXTCLOUD_ADMIN_USER / PASSWORD: Initial admin account
# NEXTCLOUD_DB_PASSWORD: Must match NEXTCLOUD_DB_PASSWORD in databases stack .env
# REDIS_PASSWORD: Must match REDIS_PASSWORD in databases stack .env
# -----------------------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NEXTCLOUD_ADMIN_PASSWORD
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# MINIO
# MINIO_ROOT_USER / PASSWORD: MinIO admin credentials (password min 8 chars)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# -----------------------------------------------------------------------------
# FILEBROWSER
# FB_NOAUTH: Set to "true" to disable authentication (not recommended for public access)
# -----------------------------------------------------------------------------
FB_NOAUTH=false

# -----------------------------------------------------------------------------
# STORAGE PATHS
# STORAGE_ROOT: Host path for shared file storage (accessible by FileBrowser + Syncthing)
# -----------------------------------------------------------------------------
STORAGE_ROOT=/data/storage
