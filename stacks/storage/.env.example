# Storage Stack Environment Configuration
# ======================================

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme123_CHANGE_IN_PRODUCTION
MINIO_DEFAULT_BUCKETS=backups,media,documents,archives

# NFS Configuration
NFS_EXPORT_OPTIONS=rw,sync,no_subtree_check,no_root_squash
NFS_ALLOWED_NETWORKS=192.168.1.0/24

# Syncthing Configuration
SYNCTHING_GUI_API_KEY=generate_secure_key_here
SYNCTHING_DEFAULT_FOLDER_PATH=/var/syncthing/Sync

# Network Configuration
STORAGE_NETWORK_SUBNET=172.20.0.0/24
STORAGE_NETWORK_GATEWAY=172.20.0.1

# Monitoring Configuration
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Security Configuration
ENABLE_TLS=true
CERTIFICATE_PATH=./certs
CERTIFICATE_DOMAIN=storage.local

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Performance Configuration
NFS_CACHE_SIZE=128m
MINIO_CACHE_ENABLED=true
MINIO_CACHE_SIZE=1G
SYNCTHING_MAX_CONNECTIONS=100

# Resource Limits (adjust based on your hardware)
NFS_CPU_LIMIT=1.0
NFS_MEMORY_LIMIT=512M
MINIO_CPU_LIMIT=2.0
MINIO_MEMORY_LIMIT=1G
SYNCTHING_CPU_LIMIT=0.5
SYNCTHING_MEMORY_LIMIT=256M

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_ROTATION_SIZE=100M

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Notes:
# 1. Change all passwords and keys in production
# 2. Adjust network settings to match your environment
# 3. Set appropriate resource limits for your hardware
# 4. Enable TLS with valid certificates for production use