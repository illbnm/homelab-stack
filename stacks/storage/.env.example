# =============================================================================
# Storage Stack — Environment Configuration
# =============================================================================

# Domain configuration (from base stack)
DOMAIN=example.com

# Timezone
TZ=UTC

# Nextcloud Admin
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme123

# Nextcloud Database
NEXTCLOUD_DB_PASSWORD=nextcloud_db_pass
NEXTCLOUD_DB_ROOT_PASSWORD=root_pass_123

# PHP Settings
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=10G

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# FileBrowser root directory (path to serve)
FILEBROWSER_ROOT=./data

# Config directory (relative to project root)
CONFIG_DIR=../../config
