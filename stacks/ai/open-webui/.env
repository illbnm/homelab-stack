import os
import logging
from pathlib import Path
from dataclasses import dataclass, asdict
from typing import Mapping

# Configure logger
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(name)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
logger = logging.getLogger(__name__)


@dataclass(frozen=True)
class OpenWebUIOIDCConfig:
    """Configuration required for Open WebUI OIDC integration."""

    auth_url: str
    client_id: str
    client_secret: str
    redirect_uri: str
    token_url: str
    userinfo_url: str
    logout_url: str
    scopes: str = "openid profile email"

    @classmethod
    def from_env(cls) -> "OpenWebUIOIDCConfig":
        """Load configuration from environment variables.

        Expected variables:
            OIDC_AUTH_URL
            OIDC_CLIENT_ID
            OIDC_CLIENT_SECRET
            OIDC_REDIRECT_URI
            OIDC_TOKEN_URL
            OIDC_USERINFO_URL
            OIDC_LOGOUT_URL
        """
        missing = [
            var
            for var in [
                "OIDC_AUTH_URL",
                "OIDC_CLIENT_ID",
                "OIDC_CLIENT_SECRET",
                "OIDC_REDIRECT_URI",
                "OIDC_TOKEN_URL",
                "OIDC_USERINFO_URL",
                "OIDC_LOGOUT_URL",
            ]
            if not os.getenv(var)
        ]
        if missing:
            raise ValueError(f"Missing required environment variables: {', '.join(missing)}")
        return cls(
            auth_url=os.getenv("OIDC_AUTH_URL"),
            client_id=os.getenv("OIDC_CLIENT_ID"),
            client_secret=os.getenv("OIDC_CLIENT_SECRET"),
            redirect_uri=os.getenv("OIDC_REDIRECT_URI"),
            token_url=os.getenv("OIDC_TOKEN_URL"),
            userinfo_url=os.getenv("OIDC_USERINFO_URL"),
            logout_url=os.getenv("OIDC_LOGOUT_URL"),
        )


def _format_env_lines(config: OpenWebUIOIDCConfig) -> list[str]:
    """Convert configuration to a list of `.env` lines."""
    mapping: Mapping[str, str] = {
        "OIDC_AUTH_URL": config.auth_url,
        "OIDC_CLIENT_ID": config.client_id,
        "OIDC_CLIENT_SECRET": config.client_secret,
        "OIDC_REDIRECT_URI": config.redirect_uri,
        "OIDC_TOKEN_URL": config.token_url,
        "OIDC_USERINFO_URL": config.userinfo_url,
        "OIDC_LOGOUT_URL": config.logout_url,
        "OIDC_SCOPES": config.scopes,
    }
    return [f"{key}={value}" for key, value in mapping.items()]


def generate_env_file(output_path: Path, config: OpenWebUIOIDCConfig) -> None:
    """Write the Open WebUI `.env` file.

    Args:
        output_path: Destination file path.
        config: OIDC configuration.
    """
    try:
        lines = _format_env_lines(config)
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
        logger.info("Successfully wrote %s", output_path)
    except Exception as exc:
        logger.error("Failed to write %s: %s", output_path, exc)
        raise


def main() -> None:
    """Entry point for the script."""
    try:
        config = OpenWebUIOIDCConfig.from_env()
        target = Path("stacks/ai/open-webui/.env")
        generate_env_file(target, config)
    except Exception as err:
        logger.exception("OpenWebUI OIDC environment generation failed: %s", err)
        raise SystemExit(1)


if __name__ == "__main__":
    main()