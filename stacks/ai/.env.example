# =============================================================================
# AI Stack — Environment Variables
# Copy to .env and fill ALL required values before running.
# =============================================================================

# Shared domain (from root .env)
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# Authentik domain (for OIDC)
AUTHENTIK_DOMAIN=auth.${DOMAIN}

# -----------------------------------------------------------------------------
# Ollama
# -----------------------------------------------------------------------------
# No configuration needed - runs on default port 11434

# -----------------------------------------------------------------------------
# Open WebUI
# -----------------------------------------------------------------------------
WEBUI_SECRET_KEY=              # REQUIRED: openssl rand -base64 32

# OIDC Configuration (filled by scripts/setup-authentik.sh)
OPENWEBUI_OAUTH_CLIENT_ID=
OPENWEBUI_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Perplexica
# -----------------------------------------------------------------------------
PERPLEXICA_SECRET=             # REQUIRED: openssl rand -base64 32
SEARXNG_SECRET=                # REQUIRED: openssl rand -base64 32

# OIDC Configuration (filled by scripts/setup-authentik.sh)
PERPLEXICA_OAUTH_CLIENT_ID=
PERPLEXICA_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Stable Diffusion
# -----------------------------------------------------------------------------
# No additional configuration needed
# Note: Uses CPU mode by default (no GPU acceleration)
