# =============================================================================
# AI Stack — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com
TZ=UTC

# -----------------------------------------------------------------------------
# OPEN WEBUI
# -----------------------------------------------------------------------------
WEBUI_SECRET_KEY=                     # openssl rand -hex 32
WEBUI_AUTH=true                       # Enable authentication
WEBUI_ENABLE_SIGNUP=true              # Allow new user registration
WEBUI_ENABLE_RAG=true                 # Enable RAG web search
AI_DEFAULT_LOCALE=en                  # Default UI language (en, zh-CN, etc.)

# -----------------------------------------------------------------------------
# PERPLEXICA (AI Search)
# -----------------------------------------------------------------------------
SEARXNG_URL=https://searxng.example.com    # SearXNG instance for web search
PERPLEXICA_MODEL=llama3.2:latest           # LLM model for search
PERPLEXICA_EMBEDDING_MODEL=nomic-embed-text:latest

# -----------------------------------------------------------------------------
# AMD GPU (ROCm) — Only if using AMD profile
# -----------------------------------------------------------------------------
HSA_OVERRIDE_GFX_VERSION=             # e.g., 10.3.0 for RX 6000 series
