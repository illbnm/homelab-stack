# AI Stack — Environment Variables
# Copy to .env and fill ALL values before running.

DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# Authentik domain (for SSO)
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Open WebUI
WEBUI_SECRET_KEY=CHANGE_ME_32chars_random

# Open WebUI OAuth2 (Authentik)
OPENWEBUI_OAUTH_CLIENT_ID=
OPENWEBUI_OAUTH_CLIENT_SECRET=

# GPU Mode
# Leave empty for auto-detection, or set: nvidia / amd / cpu
GPU_MODE=
