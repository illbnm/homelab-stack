# AI Stack Environment Variables
# Copy to .env and fill in your values

# ── Domain ──────────────────────────────────────────────────────
DOMAIN=example.com

# ── GPU Configuration ───────────────────────────────────────────
# Set to: nvidia | amd | cpu
# nvidia: Uses CUDA GPU acceleration (requires nvidia-container-toolkit)
# amd: Uses ROCm GPU acceleration (requires AMD drivers)
# cpu: Pure CPU inference (slowest but works everywhere)
GPU_TYPE=cpu

# ── Ollama Settings ─────────────────────────────────────────────
# How long to keep models in memory (e.g., 24h, 5m, 0)
OLLAMA_KEEP_ALIVE=24h
# Max models loaded simultaneously
OLLAMA_MAX_LOADED_MODELS=2
# Parallel request count
OLLAMA_NUM_PARALLEL=2

# ── Open WebUI ──────────────────────────────────────────────────
# Require authentication for web UI
WEBUI_AUTH=true
# Public-facing URL
WEBUI_URL=https://ai.example.com
# Enable RAG web search
ENABLE_RAG_WEB_SEARCH=false

# ── Perplexica ──────────────────────────────────────────────────
# Secret key for API access
PERPLEXICA_SECRET=changeme

# ── Timezone ───────────────────────────────────────────────────
TZ=Etc/UTC