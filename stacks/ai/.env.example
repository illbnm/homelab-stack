# ==============================================================================
# Homelab Stack — AI Stack Environment Variables
# ==============================================================================

DOMAIN=homelab.example.com
TZ=Asia/Shanghai

# Open WebUI Secrets & Authentik OIDC
WEBUI_SECRET_KEY=ChangeMe_OpenWebUISecretKey_2026!
ENABLE_SIGNUP=false
ENABLE_OAUTH_SIGNUP=true
OPENWEBUI_OIDC_CLIENT_ID=open-webui-oidc
OPENWEBUI_OIDC_CLIENT_SECRET=ChangeMe_OpenWebUIOidcSecret_2026!

# Ollama Resource & Model Settings
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CPU_LIMIT=4.0
OLLAMA_MEM_LIMIT=8G
OLLAMA_DEFAULT_MODELS=qwen2.5:7b,deepseek-coder-v2:16b,nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Stable Diffusion & Perplexica
SD_CLI_ARGS=--api --listen --port 7860 --use-cpu all --precision full --no-half
SD_GPU_CLI_ARGS=--api --listen --port 7860 --xformers --medvram
SEARXNG_API_URL=http://searxng:8080
