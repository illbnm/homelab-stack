# ==============================================================================
# HomeLab AI Stack Environment Configuration (.env.example)
# Supports CN Mirror acceleration, GPU profile selection, and Authentik OIDC
# ==============================================================================

DOMAIN=homelab.local
DEFAULT_LOCALE=zh-CN

# --- Hardware Acceleration Profile (cpu | cuda | rocm) ---
AI_COMPUTE_BACKEND=cpu
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
HSA_OVERRIDE_GFX_VERSION=10.3.0

# --- Locked Container Image Tags (CN Mirror Compatible) ---
# For CN mainland acceleration, replace ghcr.io with ghcr.nju.edu.cn
OLLAMA_IMAGE=ollama/ollama:0.3.14
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.3.35
SD_IMAGE=ghcr.io/abiosoft/sd-webui-docker:cpu-v1.10.1
PERPLEXICA_IMAGE=itzcrazykns1337/perplexica:v1.8.0

# HuggingFace Domestic Mirror for Model Downloads
HF_ENDPOINT=https://hf-mirror.com

# Stable Diffusion Runtime Flags
# CPU Mode: --no-half --skip-torch-cuda-test --use-cpu all --api --listen
# GPU Mode: --xformers --medvram --api --listen
SD_COMMANDLINE_ARGS=--no-half --skip-torch-cuda-test --use-cpu all --api --listen

# --- Authentik SSO / OIDC Integration ---
AI_AUTH_MIDDLEWARE=authentik@docker
WEBUI_SECRET_KEY=replace-with-32-char-random-hex-key
ENABLE_OAUTH_SIGNUP=true
OAUTH_PROVIDER_NAME=Authentik
OPENID_PROVIDER_URL=https://auth.homelab.local/application/o/open-webui/.well-known/openid-configuration
OPEN_WEBUI_OAUTH_CLIENT_ID=open-webui
OPEN_WEBUI_OAUTH_CLIENT_SECRET=replace-with-authentik-client-secret
