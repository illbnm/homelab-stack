# AI Stack — Environment Variables
# Copy to .env and fill ALL values before running.

DOMAIN=yourdomain.com
TZ=Asia/Shanghai
AUTHENTIK_DOMAIN=auth.${DOMAIN}

# Ollama
OLLAMA_GPU_ENABLED=false

# Open WebUI secret (generate with: openssl rand -base64 32)
WEBUI_SECRET_KEY=

# OAuth2 client for Open WebUI (filled by scripts/setup-authentik.sh)
OPEN_WEBUI_OAUTH_CLIENT_ID=
OPEN_WEBUI_OAUTH_CLIENT_SECRET=