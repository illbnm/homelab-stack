# ============================================
# AI Stack - Environment Configuration
# ============================================

# Domain Configuration (required for Traefik)
DOMAIN=localhost

# GPU Configuration
# Options: auto, nvidia, amd, cpu
# - auto: Automatically detect GPU (recommended)
# - nvidia: NVIDIA CUDA
# - amd: AMD ROCm
# - cpu: CPU-only mode (no GPU)
GPU_TYPE=auto

# Ollama Settings
OLLAMA_IMAGE=ollama/ollama:0.3.14
OLLAMA_GPU_LEVEL=3
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=2
OLLAMA_CONTEXT_WINDOW=8192

# Open WebUI Settings
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.3.35
WEBUI_SECRET_KEY=change-me-use-strong-random-string-min-32-chars
DEFAULT_LOCALE=zh-CN
WEBUI_NAME=Open WebUI
WEBUI_TAGLINE=Your Local AI Assistant
DEFAULT_MODEL=llama3.2
FALLBACK_MODEL=llama3.2
ENABLE_IMAGE_GENERATION=true

# Stable Diffusion Settings
SD_IMAGE=ghcr.io/AbdBarho/stable-diffusion-webui-docker:2.1
SD_ARGS=--api --listen --lowvram --precision full --no-half

# Perplexica Settings
PERPLEXICA_IMAGE=ghcr.io/itsundera/perplexica:latest
SEPERATE_RERUN_MODEL=llama3.2

# Optional: Search API Keys (enhances Perplexica results)
# Get free API keys from:
# - Tavily: https://tavily.com/
# - Serper: https://serper.dev/
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Timezone
TZ=Asia/Shanghai