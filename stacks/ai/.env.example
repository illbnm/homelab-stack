# AI Stack -- Environment Variables
# Copy to .env and fill in required values before running.

DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# Authentik domain
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Open WebUI OIDC / OAuth2 credentials -- filled by scripts/authentik-setup.sh
OPEN_WEBUI_OAUTH_CLIENT_ID=
OPEN_WEBUI_OAUTH_CLIENT_SECRET=
