# =============================================================================
# AI Stack Environment Variables
# =============================================================================

# =============================================================================
# General
# =============================================================================
DOMAIN=yourdomain.com

# =============================================================================
# Ollama - LLM Inference Engine
# =============================================================================
# GPU Configuration
# Options: all (NVIDIA), none (CPU)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# API Authentication (optional, for external access)
OLLAMA_TRAEFIK_USER=admin
OLLAMA_TRAEFIK_HASH=$$2y$$05$$CHANGE_ME_HASH

# =============================================================================
# Open WebUI - Chat Interface
# =============================================================================
# Secret key for session encryption (generate: openssl rand -hex 32)
WEBUI_SECRET_KEY=CHANGE_ME_32_CHARS_SECRET_KEY

# Authentik SSO Configuration
# Create OAuth2/OIDC application in Authentik first
OPENWEBUI_OAUTH_CLIENT_ID=your-client-id
OPENWEBUI_OAUTH_CLIENT_SECRET=your-client-secret
AUTHENTIK_DOMAIN=auth.yourdomain.com

# =============================================================================
# Stable Diffusion - Image Generation
# =============================================================================
# Device selection: cpu | cuda | rocm
SD_DEVICE=cpu

# =============================================================================
# Perplexica - AI Search Engine
# =============================================================================
# Secret key (generate: openssl rand -hex 32)
PERPLEXICA_SECRET_KEY=CHANGE_ME_32_CHARS_SECRET_KEY

# =============================================================================
# SearXNG - Search Backend
# =============================================================================
# Secret key (generate: openssl rand -hex 32)
SEARXNG_SECRET=CHANGE_ME_32_CHARS_SECRET_KEY

# =============================================================================
# Storage Management
# =============================================================================
# Maximum storage for AI models (in GB)
MAX_STORAGE_GB=100

# Retention period for temporary files (days)
RETENTION_DAYS=7

# =============================================================================
# GPU-Specific Notes
# =============================================================================
#
# For NVIDIA GPU:
# - Install nvidia-container-toolkit
# - Set NVIDIA_VISIBLE_DEVICES=all
# - SD_DEVICE=cuda
#
# For AMD GPU:
# - Install ROCm
# - Set SD_DEVICE=rocm
# - Modify docker-compose.yml to use ROCm image
#
# For CPU-only:
# - NVIDIA_VISIBLE_DEVICES=none
# - SD_DEVICE=cpu
# - Models will run slower but work without GPU
