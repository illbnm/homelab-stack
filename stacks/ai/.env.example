# =============================================================================
# AI Stack — Environment Variables
# Copy to .env and fill ALL values before running.
#
# GPU Configuration:
#   - NVIDIA GPU: OLLAMA_GPU_ENABLED=true, SD_GPU_ENABLED=true
#   - AMD GPU: OLLAMA_GPU_ENABLED=true, SD_GPU_ENABLED=true, SD_USE_AMD_GPU=1
#   - CPU only: OLLAMA_GPU_ENABLED=false, SD_GPU_ENABLED=false
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# Authentik domain (from SSO stack)
AUTHENTIK_DOMAIN=auth.yourdomain.com

# Open WebUI domain
OPEN_WEBUI_DOMAIN=ai.yourdomain.com

# -----------------------------------------------------------------------------
# Open WebUI
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
WEBUI_SECRET_KEY=

# Enable OIDC for SSO (requires OIDC client vars below)
OIDC_ENABLED=false

# OAuth2 client credentials — filled by scripts/setup-authentik.sh
OPEN_WEBUI_OIDC_CLIENT_ID=
OPEN_WEBUI_OIDC_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Stable Diffusion
# -----------------------------------------------------------------------------
# Enable GPU acceleration (requires NVIDIA GPU or AMD GPU)
SD_GPU_ENABLED=true

# Set to 1 if using AMD GPU with ROCm
SD_USE_AMD_GPU=0

# Additional command line args
SD_COMMANDLINE_ARGS=--xformers --api --enable-insecure-extension-access

# -----------------------------------------------------------------------------
# Ollama
# -----------------------------------------------------------------------------
# Set to false to force CPU-only mode
OLLAMA_GPU_ENABLED=true

# -----------------------------------------------------------------------------
# Perplexica (AI Search)
# -----------------------------------------------------------------------------
# At least ONE search API key is required:
# - Brave Search (recommended): https://brave.com/search/api/
# - Google Custom Search: https://developers.google.com/custom-search
# - SerpAPI: https://serpapi.com/
# - Tavily: https://tavily.com/
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CX=
SERPAPI_KEY=
TAVILY_API_KEY=

# Optional: Use local SearXNG instance instead of cloud search
# SEARXNG_URL=http://searxng:8080

# Perplexica OIDC (optional)
PERPLEXICA_OIDC_CLIENT_ID=
PERPLEXICA_OIDC_CLIENT_SECRET=