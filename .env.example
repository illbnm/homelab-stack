# Homelab Productivity Stack — Environment Variables
# Copy to .env and fill in your values

# ── Database ──────────────────────────────────────────
DB_PASSWORD=changeme_strong_password_here

# ── Gitea ─────────────────────────────────────────────
GITEA_DOMAIN=git.example.com

# ── Vaultwarden ───────────────────────────────────────
VAULTWARDEN_DOMAIN=vault.example.com
VAULTWARDEN_ADMIN_TOKEN=changeme_admin_token_here

# ── Outline ────────────────────────────────────────────
OUTLINE_DOMAIN=wiki.example.com
OUTLINE_SECRET_KEY=generate_64_char_hex_key
OUTLINE_UTILS_SECRET=generate_64_char_hex_key
OUTLINE_OIDC_CLIENT_ID=
OUTLINE_OIDC_CLIENT_SECRET=
OUTLINE_OIDC_AUTH_URI=
OUTLINE_OIDC_TOKEN_URI=
OUTLINE_OIDC_USERINFO_URI=

# ── BookStack ──────────────────────────────────────────
BOOKSTACK_DOMAIN=docs.example.com
BOOKSTACK_APP_KEY=generate_32_char_key

# ── System ────────────────────────────────────────────
PUID=1000
PGID=1000
