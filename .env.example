# 环境变量配置
# 复制为 .env 并填入实际值

# WireGuard 配置
WG_HOST=vpn.example.com
WG_PASSWORD=changeme123
WG_DEFAULT_DNS=10.0.0.1

# Cloudflare DDNS 配置
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_DOMAINS=example.com,www.example.com

# Nginx 配置
NGINX_DOMAIN=example.com
NGINX_SSL_CERT=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY=/etc/nginx/ssl/key.pem

# 时区
TZ=Asia/Shanghai
