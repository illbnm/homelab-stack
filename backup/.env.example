# ===========================================
# 3-2-1 Backup Configuration
# 3 份副本 | 2 种介质 | 1 份异地
# ===========================================

# 时区
TZ=Asia/Shanghai

# 备份源目录（宿主机路径）
BACKUP_SOURCE=/path/to/your/data

# 备份目标（本地）
BACKUP_LOCAL_PATH=/backups

# =====================
# S3 兼容存储配置
# =====================
# 支持: AWS S3, Cloudflare R2, Backblaze B2, MinIO 等
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_PATH=backup/

# =====================
# Backblaze B2 专用
# =====================
B2_ACCOUNT_ID=your_b2_account_id
B2_ACCOUNT_KEY=your_b2_account_key
B2_BUCKET=your-bucket-name

# =====================
# Cloudflare R2 专用
# =====================
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# =====================
# 备份计划 (cron 格式)
# =====================
# 每日 2:00 执行增量备份
BACKUP_CRON="0 2 * * *"
# 每周日 3:00 执行全量备份
FULL_BACKUP_CRON="0 3 * * 0"

# 保留策略
RETENTION_DAYS=30      # 保留 30 天
RETENTION_WEEKS=12     # 保留 12 周
RETENTION_MONTHS=6     # 保留 6 个月
RETENTION_YEARS=2      # 保留 2 年

# 排除文件 (glob 模式)
BACKUP_EXCLUDES="--exclude '*.tmp' --exclude '*.log' --exclude '.git' --exclude 'node_modules'"

# 加密密码 (强烈建议使用!)
RESTIC_PASSWORD=your_secure_password

# 通知 webhook (可选)
WEBHOOK_URL=