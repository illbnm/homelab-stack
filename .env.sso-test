# =============================================================================
# HomeLab Stack — SSO Test Environment Configuration
# This is a test configuration for validating SSO implementation
# =============================================================================

# General
TZ=Asia/Shanghai
DOMAIN=test.homelab.local
ACME_EMAIL=test@example.com

# Authentik Core
AUTHENTIK_SECRET_KEY=test_secret_key_do_not_use_in_production_32chars
AUTHENTIK_POSTGRES_PASSWORD=test_postgres_password_16
AUTHENTIK_REDIS_PASSWORD=test_redis_password_16
AUTHENTIK_BOOTSTRAP_EMAIL=admin@test.homelab.local
AUTHENTIK_BOOTSTRAP_PASSWORD=AdminPassword123!
AUTHENTIK_BOOTSTRAP_TOKEN=test_bootstrap_token_32_chars_do_not_use
AUTHENTIK_DOMAIN=auth.test.homelab.local

# Service credentials (will be populated by setup script)
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
OUTLINE_OAUTH_CLIENT_ID=
OUTLINE_OAUTH_CLIENT_SECRET=
PORTAINER_OAUTH_CLIENT_ID=
PORTAINER_OAUTH_CLIENT_SECRET=
NEXTCLOUD_OAUTH_CLIENT_ID=
NEXTCLOUD_OAUTH_CLIENT_SECRET=

# Database
POSTGRES_PASSWORD=test_postgres_master
REDIS_PASSWORD=test_redis_master
MARIADB_ROOT_PASSWORD=test_mariadb_root

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_123

# For testing only - not for production
VAULTWARDEN_ADMIN_TOKEN=test_vaultwarden_token
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=nextcloud_admin_123
