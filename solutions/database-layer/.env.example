# Domain configuration
DOMAIN=example.com

# Timezone
TZ=Asia/Shanghai

# PostgreSQL root password
POSTGRES_ROOT_PASSWORD=change_me_postgres_root

# Redis password
REDIS_PASSWORD=change_me_redis

# MariaDB root password
MARIADB_ROOT_PASSWORD=change_me_mariadb_root

# pgAdmin credentials
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin

# Redis Commander credentials
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=change_me_redis_commander

# Service database passwords
NEXTCLOUD_DB_PASSWORD=change_me_nextcloud
GITEA_DB_PASSWORD=change_me_gitea
OUTLINE_DB_PASSWORD=change_me_outline
AUTHENTIK_DB_PASSWORD=change_me_authentik
GRAFANA_DB_PASSWORD=change_me_grafana

# Optional: MinIO backup upload
# MINIO_ENDPOINT=https://minio.example.com
# MINIO_ACCESS_KEY=your_access_key
# MINIO_SECRET_KEY=your_secret_key
# MINIO_BUCKET=backups
